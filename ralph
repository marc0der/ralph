#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"
CONFIG_DIR="${RALPH_CONFIG_DIR:-$HOME/.config/ralph}"

# Safety-net cap for plan mode; a plan run normally ends on convergence,
# well before this (build mode calculates its own count from the plan)
PLAN_DEFAULT_CAP=6
# Review is a single read-only pass by default; use -n to run more
REVIEW_DEFAULT_CAP=1

ARTIFACTS=(IMPLEMENTATION_PLAN.md PROGRESS.md LEARNINGS.md REVIEW.md PROMPT_plan.md PROMPT_build.md PROMPT_review.md)
ARCHIVE_DIR=".ralph"

# IMPLEMENTATION_PLAN.md is an index of one-line entries; the detail for each
# item lives in its own file under TASK_DIR, linked from its index entry.
TASK_DIR="plan"

# Rate-limit / usage-limit retry defaults (see cmd_loop's retry wrapper).
# This caps retries of a single iteration that keeps hitting a token/usage
# limit even though each occurrence reports a valid, parseable reset time —
# it is not a generic error-retry count (see the helpers below for why).
DEFAULT_RETRIES_WHEN_TOKENS_USED=5
RETRY_RESET_BUFFER_SECONDS=30
RETRY_RESET_MAX_WAIT_SECONDS=$((60 * 60 * 5 + 60 * 30))  # 5.5 hours (30m buffer past Anthropic's 5h window)

# --- Backend definitions ---
# Each backend_<name> function sets well-known variables and defines
# build_backend_cmd(model) which populates the BACKEND_CMD array.
# Adding a new backend only requires a new function and a SUPPORTED_BACKENDS entry.

SUPPORTED_BACKENDS=(claude codex copilot pi)

# shellcheck disable=SC2034  # Variables are set here and consumed in cmd_loop
backend_claude() {
    BACKEND_NAME="claude"
    BACKEND_CLI="claude"
    BACKEND_DEFAULT_MODEL="opus"
    BACKEND_PERMISSION_FLAG="--dangerously-skip-permissions"
    BACKEND_PERMISSION_WARNING="Claude will have unrestricted access to tools (file writes, shell commands, etc)."
    BACKEND_JQ_FLAGS=(-r)
    BACKEND_JQ_FILTER='select(.type == "result") | .result // empty'
    BACKEND_STDIN_PROMPT=true
    # shellcheck disable=SC2317,SC2329  # Invoked indirectly via resolve_backend
    build_backend_cmd() {
        local model="$1"
        BACKEND_CMD=(claude -p "$BACKEND_PERMISSION_FLAG" --output-format=stream-json --model "$model" --verbose)
    }
}

# shellcheck disable=SC2034  # Variables are set here and consumed in cmd_loop
backend_codex() {
    BACKEND_NAME="codex"
    BACKEND_CLI="codex"
    BACKEND_DEFAULT_MODEL="gpt-5.2-codex"
    BACKEND_PERMISSION_FLAG="--dangerously-bypass-approvals-and-sandbox"
    BACKEND_PERMISSION_WARNING="Codex will have unrestricted access to tools (file writes, shell commands, etc)."
    BACKEND_JQ_FLAGS=(-rs)
    BACKEND_JQ_FILTER='(map(select(.item.type == "agent_message")) | last | .item.text // null) // ([ .[] | select(.item.type == "command_execution" and .item.status == "completed") | "$ " + .item.command + "\n" + (.item.aggregated_output // "") ] | join("\n") | if . == "" then null else . end) // empty'
    BACKEND_STDIN_PROMPT=false
    # shellcheck disable=SC2317,SC2329  # Invoked indirectly via resolve_backend
    build_backend_cmd() {
        local model="$1"
        BACKEND_CMD=(codex exec "$BACKEND_PERMISSION_FLAG" --json --model "$model")
    }
}

# shellcheck disable=SC2034  # Variables are set here and consumed in cmd_loop
backend_copilot() {
    BACKEND_NAME="copilot"
    BACKEND_CLI="copilot"
    BACKEND_DEFAULT_MODEL="claude-sonnet-4.6"
    BACKEND_PERMISSION_FLAG="--yolo"
    BACKEND_PERMISSION_WARNING="Copilot will have unrestricted access to tools (file writes, shell commands, etc)."
    BACKEND_JQ_FLAGS=(-rs)
    BACKEND_JQ_FILTER='(map(select(.type == "assistant.message")) | last | .data.content // null) // ([ .[] | select(.type == "tool.execution_complete" and .data.success == true) | (.data.result.content // .data.result.detailedContent // "") ] | join("\n") | if . == "" then null else . end) // empty'
    BACKEND_STDIN_PROMPT=false
    # shellcheck disable=SC2317,SC2329  # Invoked indirectly via resolve_backend
    build_backend_cmd() {
        local model="$1"
        BACKEND_CMD=(copilot --output-format=json "$BACKEND_PERMISSION_FLAG" --model "$model" -p)
    }
}

# shellcheck disable=SC2034  # Variables are set here and consumed in cmd_loop
backend_pi() {
    BACKEND_NAME="pi"
    BACKEND_CLI="pi"
    # Pi's default provider is google, so a bare 'opus' would resolve there;
    # pin the fully-qualified provider/id to land on Anthropic.
    BACKEND_DEFAULT_MODEL="anthropic/claude-opus-4-8"
    # Pi has no permission flag — its built-in tools run without prompting,
    # so build_backend_cmd omits the positional entirely (no stray empty arg).
    BACKEND_PERMISSION_FLAG=""
    BACKEND_PERMISSION_WARNING="Pi will have unrestricted access to tools (file writes, shell commands, etc)."
    BACKEND_JQ_FLAGS=(-rs)
    # Two-stage filter over the LAST agent_end event (auto-retry can emit more
    # than one). Primary: its last role=="assistant" message, joined text of
    # every type=="text" content item. Fallback: transcript from .messages —
    # each role=="toolResult" with isError==false, concatenating text content,
    # prefixed with "$ <command>" for the bash tool (command looked up from the
    # matching assistant toolCall content item by toolCallId). Empty otherwise.
    # shellcheck disable=SC2016  # $ae/$calls/$text are jq variables, not shell
    BACKEND_JQ_FILTER='(map(select(.type == "agent_end")) | last) as $ae | ([($ae.messages // [])[] | select(.role == "assistant")] | last | (.content // []) | map(select(.type == "text") | .text) | join("") | if . == "" then null else . end) // (([($ae.messages // [])[] | select(.role == "assistant") | (.content // [])[] | select(.type == "toolCall") | {key: .id, value: .}] | from_entries) as $calls | [($ae.messages // [])[] | select(.role == "toolResult" and .isError == false) | ((.content // []) | map(select(.type == "text") | .text) | join("")) as $text | if .toolName == "bash" then "$ " + ($calls[.toolCallId].arguments.command // "") + "\n" + $text else $text end] | join("\n") | if . == "" then null else . end) // empty'
    BACKEND_STDIN_PROMPT=true
    # shellcheck disable=SC2317,SC2329  # Invoked indirectly via resolve_backend
    build_backend_cmd() {
        local model="$1"
        BACKEND_CMD=(pi -p --mode json --model "$model" --no-session)
    }
}

# --- Utilities ---

# Hash stdin. Linux ships md5sum, macOS ships md5.
md5_hash() {
    if command -v md5sum &>/dev/null; then
        md5sum | cut -d' ' -f1
    elif command -v md5 &>/dev/null; then
        md5
    else
        echo "Error: no md5sum or md5 command found — install coreutils" >&2
        return 1
    fi
}

# Fail clearly when an option that takes a value is given none at all.
# A value that merely looks like a flag is left alone: the option's own
# validation reports it better than a generic parser message would.
require_option_value() {
    if [[ $# -lt 2 ]]; then
        echo "Error: option '$1' requires a value" >&2
        exit 1
    fi
}

resolve_backend() {
    local name="$1"
    local found=false
    for b in "${SUPPORTED_BACKENDS[@]}"; do
        if [[ "$b" == "$name" ]]; then
            found=true
            break
        fi
    done
    if ! $found; then
        echo "Error: unknown backend '$name'" >&2
        echo "Supported backends: ${SUPPORTED_BACKENDS[*]}" >&2
        exit 1
    fi
    "backend_${name}"
}

usage() {
    cat <<'EOF'
ralph — autonomous AI coding agent loop runner

Usage:
  ralph sandbox [--rebuild] [--no-inhibit-sleep]
  ralph sandbox clean
  ralph <plan|build|review> [options]
  ralph init
  ralph clean
  ralph archive
  ralph metrics [file]
  ralph version

Modes:
  sandbox        Enter a devcontainer shell for the current project
  sandbox clean  Remove the devcontainer for the current project
  plan           Analyse specs and source, create/update IMPLEMENTATION_PLAN.md
                 and the per-task files it links to under plan/
  build          Pick the next item, implement, test, commit, push
  review         Review the branch diff against specs, write REVIEW.md (changes nothing else)
  init           Initialise workspace (PROGRESS.md, LEARNINGS.md,
                 IMPLEMENTATION_PLAN.md, specs/, plan/)
  clean          Delete IMPLEMENTATION_PLAN.md, PROGRESS.md, LEARNINGS.md and
                 plan/ task files
  archive        Move IMPLEMENTATION_PLAN.md, PROGRESS.md, LEARNINGS.md and
                 plan/ task files to .ralph/<timestamp>/
  metrics        Summarise a run's loop metrics (latest run, or a given metrics.jsonl)

Sandbox options:
      --rebuild            Rebuild the container image from scratch
      --no-inhibit-sleep   Don't hold the host awake (caffeinate/systemd-inhibit)
                           for the sandbox session

Init options:
  -p, --prompts      Also copy prompt templates for local customisation
      --gitignore    Also add the loop artifacts (IMPLEMENTATION_PLAN.md,
                     PROGRESS.md, LEARNINGS.md, REVIEW.md, plan/, .ralph/) to
                     .gitignore.
                     Off by default — whether the plan is loop-local state or a
                     committed audit trail is the project's call

Options:
  -n, --iterations N   Max iterations (plan default: 6, build: calculated from
                       the plan, review default: 1). In build mode this also
                       disables the noop exit; in plan mode it caps the run but
                       never disables the convergence exit
  -g, --goal TEXT      Goal to inject into the prompt template
  -m, --model MODEL    Model to use (default depends on backend)
  -b, --backend NAME   Backend to use: claude, codex, copilot, pi (default: claude)
      --skip-push      Don't push after each build iteration (plan never pushes)
      --dry-run        Print what would be executed without running
      --no-metrics     Don't record per-iteration metrics under .ralph/metrics/
  -v, --verbose        Show backend commands, raw output, and exit codes
  -y, --yes            Skip the confirmation when running outside a sandbox
      --max-retries-per-iteration N
                       Max retries on a repeating token/usage limit within a
                       single iteration, each with a parseable reset time
                       (default: 5)
      --no-retry       Fail immediately on any backend error, no retry
  -h, --help           Show this help message

Examples:
  ralph plan
  ralph plan -n 2
  ralph plan -g "Migrate to hexagonal architecture"
  ralph build -n 10 -m sonnet
  ralph build -b codex
  ralph build --iterations 5 --goal "Add PATCH endpoint"
  ralph build --max-retries-per-iteration 3
  ralph build --no-retry
  ralph review
  ralph review -g "Focus on FT-001 business-rule coverage"
  ralph sandbox
  ralph sandbox --rebuild
  ralph sandbox --no-inhibit-sleep
  ralph sandbox clean
  ralph archive
EOF
    exit 0
}

cmd_version() {
    echo "ralph $VERSION"
    exit 0
}

# True when TASK_DIR holds at least one task file.
has_task_files() {
    local task
    for task in "$TASK_DIR"/*.md; do
        if [[ -f "$task" ]]; then
            return 0
        fi
    done
    return 1
}

cmd_clean() {
    local found=false
    for file in "${ARTIFACTS[@]}"; do
        [[ "$file" == PROMPT_*.md ]] && continue
        if [[ -f "$file" ]]; then
            rm "$file"
            echo "Deleted: $file"
            found=true
        fi
    done

    local task
    for task in "$TASK_DIR"/*.md; do
        [[ -f "$task" ]] || continue
        rm "$task"
        echo "Deleted: $task"
        found=true
    done
    # The directory itself stays — like specs/, it is workspace scaffolding.

    $found || echo "Nothing to clean."
}

cmd_archive() {
    local found=false
    for file in "${ARTIFACTS[@]}"; do
        [[ "$file" == PROMPT_*.md ]] && continue
        if [[ -f "$file" ]]; then
            found=true
            break
        fi
    done

    if ! $found && has_task_files; then
        found=true
    fi

    if ! $found; then
        echo "Nothing to archive."
        return
    fi

    local timestamp
    timestamp=$(date +%Y%m%d-%H%M%S)
    local dest="$ARCHIVE_DIR/$timestamp"
    mkdir -p "$dest"

    for file in "${ARTIFACTS[@]}"; do
        [[ "$file" == PROMPT_*.md ]] && continue
        if [[ -f "$file" ]]; then
            mv "$file" "$dest/"
            echo "Archived: $file -> $dest/$file"
        fi
    done

    local task
    for task in "$TASK_DIR"/*.md; do
        [[ -f "$task" ]] || continue
        mkdir -p "$dest/$TASK_DIR"
        mv "$task" "$dest/$TASK_DIR/"
        echo "Archived: $task -> $dest/$task"
    done
}

cmd_init() {
    local with_prompts=false
    local with_gitignore=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--prompts)   with_prompts=true; shift ;;
            --gitignore)    with_gitignore=true; shift ;;
            *) echo "Error: unknown init option '$1'"; exit 1 ;;
        esac
    done

    local templates_dir="$CONFIG_DIR/templates"

    # Workspace artifacts
    if [[ -f "$templates_dir/PROGRESS.md" ]]; then
        scaffold "PROGRESS.md" "$templates_dir/PROGRESS.md"
    else
        echo "Warning: PROGRESS.md template not found at $templates_dir"
    fi

    if [[ -f "$templates_dir/LEARNINGS.md" ]]; then
        scaffold "LEARNINGS.md" "$templates_dir/LEARNINGS.md"
    else
        echo "Warning: LEARNINGS.md template not found at $templates_dir"
    fi

    if [[ -f "$templates_dir/IMPLEMENTATION_PLAN.md" ]]; then
        scaffold "IMPLEMENTATION_PLAN.md" "$templates_dir/IMPLEMENTATION_PLAN.md"
    else
        echo "Warning: IMPLEMENTATION_PLAN.md template not found at $templates_dir"
    fi

    if [[ -d "specs" ]]; then
        echo "Skipped: specs/ already exists"
    else
        mkdir -p "specs"
        echo "Created: specs/"
    fi

    # Per-task detail files linked from IMPLEMENTATION_PLAN.md's index entries.
    if [[ -d "$TASK_DIR" ]]; then
        echo "Skipped: $TASK_DIR/ already exists"
    else
        mkdir -p "$TASK_DIR"
        echo "Created: $TASK_DIR/"
    fi

    # Bundled Claude Code skills (e.g. /commit) — scaffold into project-local .claude/skills/
    local skills_dir="$CONFIG_DIR/skills"
    if [[ -f "$skills_dir/commit/SKILL.md" ]]; then
        mkdir -p ".claude/skills/commit"
        scaffold ".claude/skills/commit/SKILL.md" "$skills_dir/commit/SKILL.md"
    else
        echo "Warning: commit skill not found at $skills_dir/commit/SKILL.md"
    fi

    if $with_gitignore; then
        gitignore_artifacts
    fi

    # Optional: copy prompt templates for local customisation
    if $with_prompts; then
        local prompts_dir="$CONFIG_DIR/prompts"
        if [[ ! -d "$prompts_dir" ]]; then
            echo "Error: ralph prompts not found at $prompts_dir"
            echo "Run the installer first: ./install.sh"
            exit 1
        fi
        for file in plan.md build.md review.md; do
            scaffold "PROMPT_${file}" "$prompts_dir/$file"
        done
    fi
}

gitignore_artifacts() {
    local entries=("IMPLEMENTATION_PLAN.md" "PROGRESS.md" "LEARNINGS.md" "REVIEW.md" "$TASK_DIR/" ".ralph/")

    local missing=() entry
    for entry in "${entries[@]}"; do
        grep -qxF "$entry" .gitignore 2>/dev/null || missing+=("$entry")
    done

    if [[ ${#missing[@]} -eq 0 ]]; then
        echo "Skipped: .gitignore already ignores the loop artifacts"
        return
    fi

    if [[ ! -f ".gitignore" ]]; then
        touch .gitignore
        echo "Created: .gitignore"
    fi
    # Ensure the file ends with a newline before appending
    [[ -s .gitignore && $(tail -c1 .gitignore) != "" ]] && echo >> .gitignore
    [[ -s .gitignore ]] && printf '\n' >> .gitignore

    echo "# Ralph loop artifacts" >> .gitignore
    for entry in "${missing[@]}"; do
        echo "$entry" >> .gitignore
        echo "Added to .gitignore: $entry"
    done
}

scaffold() {
    local target="$1"
    local source="$2"
    if [[ -f "$target" ]]; then
        echo "Skipped: $target already exists"
    else
        cp "$source" "$target"
        echo "Created: $target"
    fi
}

cmd_sandbox() {
    local rebuild=false
    local inhibit_sleep=true

    while [[ $# -gt 0 ]]; do
        case "$1" in
            clean)              sandbox_clean; return ;;
            --rebuild)          rebuild=true; shift ;;
            --no-inhibit-sleep) inhibit_sleep=false; shift ;;
            *)                  echo "Error: unknown sandbox option '$1'" >&2; exit 1 ;;
        esac
    done

    if ! command -v devcontainer >/dev/null 2>&1; then
        echo "Error: 'devcontainer' CLI not found in PATH." >&2
        echo "Install it with: npm install -g @devcontainers/cli" >&2
        exit 1
    fi

    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Error: not inside a git repository." >&2
        exit 1
    fi

    # A submodule worktree's `.git` is a file containing a relative gitdir
    # pointer (e.g. `gitdir: ../../.git/modules/foo`). Bind-mounting the
    # workspace at /workspace in the container leaves the pointer unchanged,
    # so it resolves to a path that doesn't exist inside the container and
    # every subsequent git command — including devcontainer's own
    # postStartCommand — fails. Reject early with actionable guidance.
    if [[ -f .git && ! -d .git ]]; then
        echo "Error: workspace is a git submodule, which is not supported as a sandbox root." >&2
        echo "The submodule's .git pointer is relative to the parent repo and does not" >&2
        echo "resolve inside the container. Run ralph from the parent repository, or clone" >&2
        echo "the submodule's remote URL as a standalone repository." >&2
        exit 1
    fi

    local config="$CONFIG_DIR/container/devcontainer.json"
    if [[ ! -f "$config" ]]; then
        echo "Error: devcontainer config not found at $config" >&2
        echo "Run the installer first: ./install.sh" >&2
        exit 1
    fi

    mkdir -p "$HOME/.claude" "$HOME/.codex" "$HOME/.copilot" "$HOME/.pi/agent"

    # Runtime mounts (conditional on host file existence)
    local mounts=()
    local ralph_bin
    ralph_bin="$(command -v ralph)"
    mounts+=("type=bind,source=$ralph_bin,target=/usr/local/bin/ralph")
    mounts+=("type=bind,source=$CONFIG_DIR,target=/home/node/.config/ralph")

    if [[ -d "$HOME/.ssh" ]]; then
        mounts+=("type=bind,source=$HOME/.ssh,target=/home/node/.ssh")
    fi
    if [[ -d "$HOME/.config/gh" ]]; then
        mounts+=("type=bind,source=$HOME/.config/gh,target=/home/node/.config/gh")
    fi
    if [[ -d "$HOME/.codex" ]]; then
        mounts+=("type=bind,source=$HOME/.codex,target=/home/node/.codex")
    fi
    if [[ -d "$HOME/.copilot" ]]; then
        mounts+=("type=bind,source=$HOME/.copilot,target=/home/node/.copilot")
    fi
    if [[ -d "$HOME/.pi" ]]; then
        mounts+=("type=bind,source=$HOME/.pi,target=/home/node/.pi")
    fi

    local ssh_env=()
    if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
        mounts+=("type=bind,source=$SSH_AUTH_SOCK,target=/tmp/ssh-agent.sock")
        ssh_env=("--remote-env" "SSH_AUTH_SOCK=/tmp/ssh-agent.sock")
    fi

    # GPG agent forwarding — lets the build loop sign commits with the host key
    # without copying any private key material into the container. The host
    # gpg-agent holds the secret; the container's gpg reaches it over the
    # forwarded socket and reads the mounted public keyring. Prefer the agent's
    # restricted "extra" socket, falling back to the standard socket.
    if command -v gpgconf >/dev/null 2>&1; then
        local gpg_sock gpg_home
        gpg_sock="$(gpgconf --list-dirs agent-extra-socket 2>/dev/null)"
        [[ -S "$gpg_sock" ]] || gpg_sock="$(gpgconf --list-dirs agent-socket 2>/dev/null)"
        if [[ -S "$gpg_sock" ]]; then
            mounts+=("type=bind,source=$gpg_sock,target=/home/node/.gnupg/S.gpg-agent")
            gpg_home="$(gpgconf --list-dirs homedir 2>/dev/null)"
            if [[ -f "$gpg_home/pubring.kbx" ]]; then
                # The devcontainer CLI's --mount only accepts type/source/target
                # (and optional external); it rejects a `readonly` key, unlike
                # the static mounts in devcontainer.json.
                mounts+=("type=bind,source=$gpg_home/pubring.kbx,target=/home/node/.gnupg/pubring.kbx")
            fi
        fi
    fi
    if [[ -n "${OPENAI_API_KEY:-}" ]]; then
        ssh_env+=("--remote-env" "OPENAI_API_KEY=$OPENAI_API_KEY")
    fi
    if [[ -n "${OPENROUTER_API_KEY:-}" ]]; then
        ssh_env+=("--remote-env" "OPENROUTER_API_KEY=$OPENROUTER_API_KEY")
    fi
    if [[ -n "${GEMINI_API_KEY:-}" ]]; then
        ssh_env+=("--remote-env" "GEMINI_API_KEY=$GEMINI_API_KEY")
    fi
    if [[ -n "${ANTHROPIC_BASE_URL:-}" ]]; then
        ssh_env+=("--remote-env" "ANTHROPIC_BASE_URL=$ANTHROPIC_BASE_URL")
    fi
    if [[ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]]; then
        ssh_env+=("--remote-env" "ANTHROPIC_AUTH_TOKEN=$ANTHROPIC_AUTH_TOKEN")
    fi
    if [[ -n "${ANTHROPIC_API_KEY+set}" ]]; then
        ssh_env+=("--remote-env" "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}")
    fi
    # Derive a GitHub token from the host keyring when none is exported. gh's
    # secure storage keeps the token in the OS keyring, which the container cannot
    # reach via the ~/.config/gh bind mount; `gh auth token` reads it on the host so
    # it can be forwarded as an env var (highest precedence in gh) below.
    if [[ -z "${GH_TOKEN:-}" && -z "${GITHUB_TOKEN:-}" ]] && command -v gh >/dev/null 2>&1; then
        local gh_token
        gh_token="$(gh auth token 2>/dev/null)" || true
        if [[ -n "$gh_token" ]]; then
            GH_TOKEN="$gh_token"
        else
            echo "Warning: gh is installed but no GitHub token is available (run 'gh auth login'" >&2
            echo "on the host). The sandbox will start without GitHub CLI authentication." >&2
        fi
    fi
    if [[ -n "${GH_TOKEN:-}" ]]; then
        ssh_env+=("--remote-env" "GH_TOKEN=$GH_TOKEN")
    fi
    if [[ -n "${GITHUB_TOKEN:-}" ]]; then
        ssh_env+=("--remote-env" "GITHUB_TOKEN=$GITHUB_TOKEN")
    fi

    # Shell history volume (deterministic per workspace)
    local workspace_hash
    workspace_hash=$(echo -n "$PWD" | md5_hash | cut -c1-12) || return 1
    mounts+=("type=volume,source=ralph-history-${workspace_hash},target=/commandhistory")

    local mount_flags=()
    for mount in "${mounts[@]}"; do
        mount_flags+=("--mount" "$mount")
    done

    # Start or reuse container
    local up_args=(
        "--workspace-folder" "$PWD"
        "--config" "$config"
        "${mount_flags[@]}"
        ${ssh_env[@]+"${ssh_env[@]}"}
    )
    if $rebuild; then
        up_args+=("--remove-existing-container" "--build-no-cache")
    fi

    # Sleep inhibition — a devcontainer is suspended along with the host, which
    # stalls a long unattended build mid-iteration. Hold the host awake for the
    # whole sandbox session (image build/pull included) via the platform's
    # inhibitor, backgrounded and released on any exit from this function,
    # including Ctrl-C.
    local sleep_inhibitor_pid=""
    if $inhibit_sleep; then
        if command -v caffeinate >/dev/null 2>&1; then
            caffeinate -dimsu -w $$ &
            sleep_inhibitor_pid=$!
        elif command -v systemd-inhibit >/dev/null 2>&1; then
            systemd-inhibit --what=idle:sleep --why="ralph sandbox session" sleep infinity &
            sleep_inhibitor_pid=$!
        else
            echo "Warning: no sleep inhibitor found (caffeinate/systemd-inhibit not in PATH)." >&2
            echo "The host may sleep during a long unattended run, suspending the container." >&2
        fi
        # The EXIT trap fires after this function returns, once `local`s are gone
        # — bake the PID into the trap command as a literal (double-quoted, so it
        # expands now) rather than referencing the variable name.
        if [[ -n "$sleep_inhibitor_pid" ]]; then
            # shellcheck disable=SC2064 # intentional: expand the PID now, before it goes out of scope
            trap "kill $sleep_inhibitor_pid 2>/dev/null" EXIT
        fi
    fi

    echo "Starting sandbox..."
    devcontainer up "${up_args[@]}"

    # Drop into shell
    devcontainer exec \
        --workspace-folder "$PWD" \
        --config "$config" \
        ${ssh_env[@]+"${ssh_env[@]}"} \
        zsh
}

sandbox_clean() {
    if ! command -v docker >/dev/null 2>&1; then
        echo "Error: 'docker' not found in PATH." >&2
        exit 1
    fi

    local container_id
    container_id=$(docker ps -a --filter "label=devcontainer.local_folder=$PWD" --format '{{.ID}}')

    if [[ -z "$container_id" ]]; then
        echo "No sandbox container found for $PWD"
        return
    fi

    docker rm -f "$container_id" >/dev/null
    echo "Removed sandbox container for $PWD"
}

# Resolve which prompt file to use.
# Priority: project-local PROMPT_<mode>.md > installed default
resolve_prompt() {
    local mode="$1"
    local local_file="PROMPT_${mode}.md"
    local default_file="$CONFIG_DIR/prompts/${mode}.md"

    if [[ -f "$local_file" ]]; then
        echo "$local_file"
    elif [[ -f "$default_file" ]]; then
        echo "$default_file"
    else
        echo "Error: no prompt found for mode '$mode'" >&2
        echo "Looked for: $local_file, $default_file" >&2
        echo "Run 'ralph init' to scaffold local prompts, or reinstall with ./install.sh" >&2
        exit 1
    fi
}

# Verify workspace artifacts produced by 'ralph init' are present.
# Plan needs IMPLEMENTATION_PLAN.md (the template the agent fills in).
# Build needs IMPLEMENTATION_PLAN.md, PROGRESS.md and LEARNINGS.md.
require_init_artifacts() {
    local mode="$1"
    local required=()

    case "$mode" in
        plan)  required=(IMPLEMENTATION_PLAN.md) ;;
        build) required=(IMPLEMENTATION_PLAN.md PROGRESS.md LEARNINGS.md) ;;
        # Review scaffolds nothing: it writes REVIEW.md afresh and reads the
        # plan/progress files only if they happen to exist. Return before the
        # loop below — expanding an empty array trips set -u on bash < 4.4.
        *)     return 0 ;;
    esac

    local missing=()
    for f in "${required[@]}"; do
        [[ -f "$f" ]] || missing+=("$f")
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "Error: missing workspace artifacts required for '$mode': ${missing[*]}" >&2
        echo "Run 'ralph init' to scaffold them before running 'ralph $mode'." >&2
        exit 1
    fi
}

# The part of the plan that holds real items — everything below '## Items'.
#
# The scaffolded '## Entry Format' section documents the entry shape by example.
# This template indents its exemplar so it does not match '^- \[', but that is a
# property of the template's formatting, not a guarantee: a reworded header, a
# hand-written plan, or an agent pasting an example back at column zero would
# each put a checkbox above '## Items'. Scoping the read to the items section
# means counting never depends on how the prose above it happens to be laid out.
#
# Plans without the heading are read whole, so older and hand-written plans work.
plan_items_body() {
    local file="IMPLEMENTATION_PLAN.md"
    if grep -qE '^## Items[[:space:]]*$' "$file" 2>/dev/null; then
        sed -n '/^## Items[[:space:]]*$/,$p' "$file"
    else
        cat "$file"
    fi
}

# Calculate build iterations from IMPLEMENTATION_PLAN.md.
# Counts incomplete items (- [ ]) and adds 20% headroom (rounded up, minimum 1).
# Caller must ensure IMPLEMENTATION_PLAN.md exists (see require_init_artifacts).
calculate_build_iterations() {
    local count
    count=$(plan_items_body | grep -c '^- \[ \]' || true)

    if [[ "$count" -eq 0 ]]; then
        echo "Error: no incomplete items in IMPLEMENTATION_PLAN.md. Run 'ralph plan' first." >&2
        exit 1
    fi

    # 20% headroom, rounded up: ceil(count * 1.2)
    echo $(( (count * 6 + 4) / 5 ))
}

# Fingerprint the artifacts a plan iteration is allowed to change.
# Plan mode never commits (IMPLEMENTATION_PLAN.md is gitignored), so HEAD cannot
# detect progress. A pass that leaves this hash unchanged has converged.
#
# TASK_DIR is hashed alongside the index: the index is one line per item, so a
# pass that only rewrites an item's scope or verification criteria changes a
# task file and nothing else. Hashing the index alone would read that as
# convergence and stop the run mid-plan.
plan_state_hash() {
    {
        if [[ -f "IMPLEMENTATION_PLAN.md" ]]; then
            cat "IMPLEMENTATION_PLAN.md"
        fi
        if [[ -d "$TASK_DIR" ]]; then
            # Names as well as contents, so adding or removing a task file counts.
            find -L "$TASK_DIR" -type f -name '*.md' | LC_ALL=C sort | while IFS= read -r task; do
                echo "$task"
                cat -- "$task" || true
            done
        fi
        if [[ -d "specs" ]]; then
            # Hash names as well as contents so adding or removing a spec counts
            # as a change. LC_ALL=C keeps the order stable across platforms.
            # -L follows symlinked specs; an unreadable one must not abort the run.
            find -L specs -type f | LC_ALL=C sort | while IFS= read -r spec; do
                echo "$spec"
                cat -- "$spec" || true
            done
        fi
    } 2>/dev/null | md5_hash
}

# Paths a build iteration changed, excluding the loop's own bookkeeping.
#
# A build iteration always rewrites IMPLEMENTATION_PLAN.md and PROGRESS.md, and
# may revise LEARNINGS.md in place on any pass. `ralph init` no longer gitignores
# them, so a project that commits its artifacts advances HEAD every pass. A bare
# HEAD comparison would then read a stalled loop as progress and never exit
# early. Ask the narrower question instead: did this iteration change anything
# other than the plan, the log and the learnings?
#
# Empty output means no source progress, whether or not HEAD moved.
build_progress_paths() {
    local before="$1" after="$2"
    [[ "$before" == "$after" ]] && return 0
    git diff --name-only "$before" "$after" -- . \
        ":(exclude)IMPLEMENTATION_PLAN.md" \
        ":(exclude)PROGRESS.md" \
        ":(exclude)LEARNINGS.md" \
        ":(exclude)REVIEW.md" \
        ":(exclude)${TASK_DIR}/" \
        ":(exclude).ralph/"
}

truncate_line() {
    local text="$1" max="$2"
    if [[ ${#text} -gt $max ]]; then
        echo "${text:0:$((max - 3))}..."
    else
        echo "$text"
    fi
}

# --- Rate-limit / usage-limit retry helpers ---
#
# Backend CLIs (at least Claude Code, see anthropics/claude-code#35540) exit
# non-zero for every failure type — transient rate limits, usage-limit
# exhaustion, and genuine errors alike — so detection has to be content-based
# rather than exit-code-based.
#
# Deliberately no blind exponential-backoff fallback: if the output is
# classified as rate-limited but no reset time can be parsed out of it, that
# is a gap in detection, not a case to paper over with a guessed wait. It
# fails loudly instead, so the gap gets fixed rather than hidden.

# True if the combined backend stdout/stderr looks like a rate-limit or
# usage-limit failure rather than a genuine error.
is_rate_limit_failure() {
    local text="${1,,}"
    [[ "$text" == *"usage limit"* ]] && return 0
    [[ "$text" == *"rate_limit_error"* ]] && return 0
    [[ "$text" == *"rate limit"* ]] && return 0
    [[ "$text" == *"overloaded_error"* ]] && return 0
    return 1
}

# Extracts a reset epoch (seconds) from a "...|<epoch>" style message, if
# present. Claude Code's own usage-limit messages carry the reset time this
# way (seen verbatim in its auto-filed bug report titles, e.g.
# "Claude AI usage limit reached|1754298000"). Echoes nothing if absent.
extract_reset_epoch() {
    local text="$1"
    if [[ "$text" =~ \|([0-9]{10,13}) ]]; then
        local raw="${BASH_REMATCH[1]}"
        if [[ ${#raw} -ge 13 ]]; then
            echo $(( raw / 1000 ))
        else
            echo "$raw"
        fi
    fi
}

# Seconds to wait before retrying, given a reset epoch (capped against a
# garbage or far-future parse). Caller must ensure reset_epoch is non-empty.
compute_retry_wait() {
    local reset_epoch="$1"
    local now wait
    now=$(date +%s)
    wait=$(( reset_epoch - now + RETRY_RESET_BUFFER_SECONDS ))
    [[ $wait -lt 5 ]] && wait=5
    [[ $wait -gt $RETRY_RESET_MAX_WAIT_SECONDS ]] && wait=$RETRY_RESET_MAX_WAIT_SECONDS
    echo "$wait"
}

# Formats a seconds count as a short human-readable duration (e.g. "12m", "1h5m").
format_duration() {
    local seconds="$1"
    if [[ $seconds -lt 60 ]]; then
        echo "${seconds}s"
    elif [[ $seconds -lt 3600 ]]; then
        echo "$(( seconds / 60 ))m"
    else
        local hours=$(( seconds / 3600 )) mins=$(( (seconds % 3600) / 60 ))
        if [[ $mins -eq 0 ]]; then
            echo "${hours}h"
        else
            echo "${hours}h${mins}m"
        fi
    fi
}

# First incomplete item in IMPLEMENTATION_PLAN.md, stripped of the checkbox
# prefix, markdown emphasis, and the trailing link to its task file — the item
# the build prompt directs the agent to pick next. Empty when the file is absent
# or every item is complete.
#
# Done in a single sed that quits at the first match rather than piping into
# head: under `set -o pipefail` a head that closes the pipe early makes the
# whole pipeline non-zero, which would abort the loop on a long plan.
next_plan_item() {
    plan_items_body 2>/dev/null | sed -nE '/^- \[ \]/{
        s/^- \[ \] *//
        s/\*\*//g
        s/[[:space:]]*(→|->)?[[:space:]]*\[[^]]*\]\([^)]*\)[[:space:]]*$//
        p
        q
    }'
}

# --- Metrics capture ---
# Each non-dry-run iteration appends one JSON line to
# .ralph/metrics/<branch>-<run>/metrics.jsonl and retains the raw backend
# stream alongside (iter-NNN.stream.jsonl). Result-event fields (duration,
# turns, cost, token usage) are populated for the claude backend; other
# backends degrade to nulls. A failure here never interrupts the loop.

fmt_duration() {
    local s="$1"
    if [[ -z "$s" || "$s" == "null" ]]; then
        echo "-"
        return
    fi
    if (( s >= 3600 )); then
        printf '%dh%02dm%02ds' $((s / 3600)) $((s % 3600 / 60)) $((s % 60))
    elif (( s >= 60 )); then
        printf '%dm%02ds' $((s / 60)) $((s % 60))
    else
        printf '%ds' "$s"
    fi
}

# Epoch → ISO 8601 UTC; GNU date first, BSD/macOS fallback.
iso_utc() {
    date -u -d "@$1" +%FT%TZ 2>/dev/null || date -u -r "$1" +%FT%TZ
}

write_iteration_metrics() {
    local metrics_file="$1" raw_file="$2" mode="$3" branch="$4" backend="$5" model="$6"
    local iteration="$7" started="$8" ended="$9" head_before="${10}" head_after="${11}" plan_done_before="${12}"
    local plan_noop="${13:-}"

    local commits=0 stat="" files="" ins="" del="" noop=true
    if [[ "$head_before" != "$head_after" ]]; then
        noop=false
        commits=$(git rev-list --count "$head_before..$head_after" 2>/dev/null || echo 0)
        stat=$(git diff --shortstat "$head_before" "$head_after" 2>/dev/null || true)
        files=$(sed -nE 's/.* ([0-9]+) files? changed.*/\1/p' <<<"$stat")
        ins=$(sed -nE 's/.* ([0-9]+) insertions?\(\+\).*/\1/p' <<<"$stat")
        del=$(sed -nE 's/.* ([0-9]+) deletions?\(-\).*/\1/p' <<<"$stat")
    fi
    files=${files:-0}; ins=${ins:-0}; del=${del:-0}

    # Plan iterations never commit, so HEAD cannot describe them. The caller
    # passes a verdict derived from the plan artifacts instead.
    if [[ -n "$plan_noop" ]]; then
        noop=$plan_noop
    fi

    local plan_done_after=0 plan_delta=0
    if [[ -f "IMPLEMENTATION_PLAN.md" ]]; then
        plan_done_after=$(plan_items_body | grep -c '^- \[x\]' || true)
    fi
    plan_delta=$(( plan_done_after - plan_done_before ))
    (( plan_delta < 0 )) && plan_delta=0

    # Backend result-event summary + tool-call histogram (claude stream-json
    # shape; other backends yield nulls and an empty histogram).
    local backend_summary
    backend_summary=$(jq -cs '
        (map(select(.type == "result")) | last // {}) as $r
        | { api_s: (if $r.duration_api_ms then ($r.duration_api_ms / 1000 | round) else null end),
            turns: ($r.num_turns // null),
            cost_usd: ($r.total_cost_usd // null),
            tokens: (if $r.usage then {
                input: ($r.usage.input_tokens // 0),
                output: ($r.usage.output_tokens // 0),
                cache_read: ($r.usage.cache_read_input_tokens // 0),
                cache_write: ($r.usage.cache_creation_input_tokens // 0)
              } else null end),
            session_id: ($r.session_id // null),
            result_status: ($r.subtype // null),
            tools: ([ .[] | select(.type == "assistant") | .message.content[]?
                      | select(.type == "tool_use") | .name ]
                    | group_by(.) | map({key: .[0], value: length}) | from_entries)
          }' "$raw_file" 2>/dev/null) || backend_summary='{}'
    [[ -z "$backend_summary" ]] && backend_summary='{}'

    jq -cn \
        --argjson iteration "$iteration" \
        --arg mode "$mode" --arg branch "$branch" \
        --arg backend "$backend" --arg model "$model" \
        --arg started "$(iso_utc "$started")" \
        --arg ended "$(iso_utc "$ended")" \
        --argjson wall_s "$(( ended - started ))" \
        --argjson commits "$commits" --argjson files "$files" \
        --argjson insertions "$ins" --argjson deletions "$del" \
        --argjson noop "$noop" --argjson plan_done "$plan_delta" \
        --argjson backend_summary "$backend_summary" \
        '{iteration: $iteration, mode: $mode, branch: $branch, backend: $backend,
          model: $model, started: $started, ended: $ended, wall_s: $wall_s}
         + $backend_summary
         + {git: {commits: $commits, files_changed: $files,
                  insertions: $insertions, deletions: $deletions, noop: $noop},
            plan_items_completed: $plan_done}' >> "$metrics_file"
}

# One-line human summary of the last metrics record (everything after the
# wall-clock figure, which the caller prefixes via fmt_duration).
metrics_summary_suffix() {
    local metrics_file="$1"
    tail -n 1 "$metrics_file" | jq -r '
        (if .api_s then " · " + (.api_s | tostring) + "s api" else "" end)
        + (if .turns then " · " + (.turns | tostring) + " turns" else "" end)
        + (if .cost_usd then " · $" + (((.cost_usd * 100 | round) / 100) | tostring) else "" end)
        + " · " + (.git.commits | tostring) + " commits (+" + (.git.insertions | tostring)
        + "/-" + (.git.deletions | tostring) + ")"
        + (if (.tools | length) > 0 then " · " + (.tools | to_entries | sort_by(-.value)
            | map(.key + " " + (.value | tostring)) | join(", ")) else "" end)' 2>/dev/null || true
}

cmd_metrics() {
    local file="${1:-}"
    if [[ -z "$file" ]]; then
        # shellcheck disable=SC2012  # newest-by-mtime needs ls; paths are ralph-generated (no odd filenames)
        file=$(ls -1t "$ARCHIVE_DIR"/metrics/*/metrics.jsonl 2>/dev/null | head -1 || true)
    fi
    if [[ -z "$file" || ! -f "$file" ]]; then
        echo "No metrics found under $ARCHIVE_DIR/metrics/." >&2
        echo "Usage: ralph metrics [path/to/metrics.jsonl]" >&2
        exit 1
    fi

    echo "Run: $file"
    echo ""

    local table
    table=$({
        printf 'ITER\tWALL\tAPI\tTURNS\tCOST\tTOK_IN\tTOK_OUT\tCACHE_RD\tCOMMITS\t+/-\tPLAN\tTOP_TOOLS\n'
        jq -r '
            def fmtd: if . == null then "-"
              elif . >= 3600 then "\(. / 3600 | floor)h\(. % 3600 / 60 | floor)m"
              elif . >= 60 then "\(. / 60 | floor)m\(. % 60)s"
              else "\(.)s" end;
            [ .iteration,
              (.wall_s | fmtd),
              (.api_s | fmtd),
              (.turns // "-"),
              (if .cost_usd then "$\((.cost_usd * 100 | round) / 100)" else "-" end),
              (.tokens.input // "-"), (.tokens.output // "-"), (.tokens.cache_read // "-"),
              .git.commits, "+\(.git.insertions)/-\(.git.deletions)",
              .plan_items_completed,
              ((.tools // {}) | to_entries | sort_by(-.value) | .[0:3]
                | map("\(.key):\(.value)") | join(" ") | if . == "" then "-" else . end)
            ] | @tsv' "$file"
    })
    if command -v column >/dev/null 2>&1; then
        column -t -s $'\t' <<<"$table"
    else
        echo "$table"
    fi

    echo ""
    jq -rs '
        def fmtd: if . == null then "-"
          elif . >= 3600 then "\(. / 3600 | floor)h\(. % 3600 / 60 | floor)m"
          elif . >= 60 then "\(. / 60 | floor)m\(. % 60)s"
          else "\(.)s" end;
        (map(.wall_s) | add) as $wall
        | (map(.api_s // 0) | add) as $api
        | (map(.cost_usd // 0) | add) as $cost
        | "Totals: \(length) iterations · wall \($wall | fmtd) · api \($api | fmtd)"
          + " · turns \(map(.turns // 0) | add)"
          + " · cost $\(($cost * 100 | round) / 100)"
          + " · tokens in \(map(.tokens.input // 0) | add) / out \(map(.tokens.output // 0) | add)"
          + " (cache read \(map(.tokens.cache_read // 0) | add))"
          + " · commits \(map(.git.commits) | add)"
          + " (+\(map(.git.insertions) | add)/-\(map(.git.deletions) | add))"
          + " · plan items \(map(.plan_items_completed) | add)"
          + " · noop iterations \([.[] | select(.git.noop)] | length)"
        ' "$file"
}

cmd_loop() {
    local mode="$1"
    shift

    # Parse flags
    local max_iterations=""
    local goal=""
    local model=""
    local backend=""
    local skip_push=false
    local dry_run=false
    local verbose=false
    local assume_yes=false
    local max_retries_opt=""
    local no_retry=false
    local no_metrics=false

    # Parsed by hand rather than with getopt(1). BSD getopt, which is what macOS
    # ships, does not understand --long and returns the whole invocation as
    # positional junk — every flag was then silently dropped, so --dry-run ran
    # the backend for real and --skip-push pushed. cmd_sandbox already parses its
    # own flags this way. The mode is shifted off above, so there are no
    # positionals left to permute and getopt bought only the --opt=value form,
    # which the first branch handles.
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --*=*)
                # Normalise --opt=value into --opt value, then re-dispatch
                set -- "${1%%=*}" "${1#*=}" "${@:2}"
                continue
                ;;
            -n|--iterations)             require_option_value "$@"; max_iterations="$2";  shift 2 ;;
            -g|--goal)                   require_option_value "$@"; goal="$2";            shift 2 ;;
            -m|--model)                  require_option_value "$@"; model="$2";           shift 2 ;;
            -b|--backend)                require_option_value "$@"; backend="$2";         shift 2 ;;
            --max-retries-per-iteration) require_option_value "$@"; max_retries_opt="$2"; shift 2 ;;
            --skip-push)     skip_push=true;      shift ;;
            --dry-run)       dry_run=true;        shift ;;
            --no-metrics)    no_metrics=true;     shift ;;
            --no-retry)      no_retry=true;       shift ;;
            -v|--verbose)    verbose=true;        shift ;;
            -y|--yes)        assume_yes=true;     shift ;;
            -h|--help)       usage ;;
            --)              shift; break ;;
            *)
                echo "Error: unknown option '$1' for 'ralph $mode'" >&2
                echo "Run 'ralph --help' for usage." >&2
                exit 1
                ;;
        esac
    done

    # Validate explicit -n value before any state-dependent work, so syntax
    # errors fire regardless of workspace state.
    local hard_override=false
    if [[ -n "$max_iterations" ]]; then
        if [[ ! "$max_iterations" =~ ^[1-9][0-9]*$ ]]; then
            echo "Error: iterations must be a positive integer, got '$max_iterations'" >&2
            exit 1
        fi
        hard_override=true
    fi

    local max_retries=$DEFAULT_RETRIES_WHEN_TOKENS_USED
    if [[ -n "$max_retries_opt" ]]; then
        if [[ ! "$max_retries_opt" =~ ^[0-9]+$ ]]; then
            echo "Error: --max-retries-per-iteration must be a non-negative integer, got '$max_retries_opt'" >&2
            exit 1
        fi
        max_retries=$max_retries_opt
    fi
    $no_retry && max_retries=0

    # Fail fast if 'ralph init' hasn't been run — checked before any backend
    # resolution, CLI lookup, or git work so the user gets immediate feedback.
    require_init_artifacts "$mode"

    # Resolve backend: CLI flag > default
    backend="${backend:-claude}"
    resolve_backend "$backend"

    # Apply backend default model if -m not explicitly passed
    if [[ -z "$model" ]]; then
        model="$BACKEND_DEFAULT_MODEL"
    fi

    # Resolve iteration count from defaults/heuristics when -n wasn't passed.
    if ! $hard_override; then
        case "$mode" in
            plan)   max_iterations=$PLAN_DEFAULT_CAP ;;
            build)  max_iterations=$(calculate_build_iterations) ;;
            review) max_iterations=$REVIEW_DEFAULT_CAP ;;
        esac
    fi

    # Verify backend CLI is available (not needed for dry-run)
    if ! $dry_run && ! command -v "$BACKEND_CLI" >/dev/null 2>&1; then
        echo "Error: '$BACKEND_CLI' CLI not found in PATH." >&2
        exit 1
    fi

    # Verify git is available and we're inside a repo
    if ! command -v git >/dev/null 2>&1; then
        echo "Error: 'git' not found in PATH." >&2
        exit 1
    fi
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Error: not inside a git repository. Run 'git init' first." >&2
        exit 1
    fi

    local prompt_file
    prompt_file=$(resolve_prompt "$mode")

    local current_branch
    current_branch=$(git branch --show-current)

    # Build the backend command array now that model is resolved
    build_backend_cmd "$model"

    # Metrics capture (on by default for real runs; see --no-metrics)
    local metrics_enabled=true
    ($dry_run || $no_metrics) && metrics_enabled=false
    local metrics_dir="" metrics_file=""
    if $metrics_enabled; then
        # PID suffix keeps runs started within the same second distinct
        metrics_dir="$ARCHIVE_DIR/metrics/${current_branch//\//-}-$(date +%Y%m%d-%H%M%S)-$$"
        metrics_file="$metrics_dir/metrics.jsonl"
        if ! mkdir -p "$metrics_dir" 2>/dev/null; then
            echo "Warning: cannot create $metrics_dir; metrics disabled for this run" >&2
            metrics_enabled=false
        fi
    fi

    local line_width=120
    local bar
    bar=$(printf '━%.0s' $(seq 1 "$line_width"))

    echo "$bar"
    echo "Mode:    $mode"
    echo "Backend: $BACKEND_NAME"
    truncate_line "Prompt:  $prompt_file" "$line_width"
    echo "Branch:  $current_branch"
    echo "Model:   $model"
    echo "Max:     $max_iterations iterations"
    [[ -n "$goal" ]] && truncate_line "Goal:    $goal" "$line_width"
    $metrics_enabled && truncate_line "Metrics: $metrics_file" "$line_width"
    echo "$bar"

    # Permission handling:
    #   Backends run non-interactively and cannot prompt for tool approval,
    #   so the backend's permission flag is always required.
    #   Inside a devcontainer, network isolation provides additional safety.
    if [[ "${DEVCONTAINER:-false}" != "true" ]]; then
        # Some backends (pi) have no permission flag — drop the "with <flag>"
        # clause so the line doesn't render with a double space or a stray empty arg.
        local first_warning
        if [[ -n "$BACKEND_PERMISSION_FLAG" ]]; then
            first_warning="⚠️  WARNING: Running with $BACKEND_PERMISSION_FLAG outside a container."
        else
            first_warning="⚠️  WARNING: Running outside a container."
        fi
        truncate_line "$first_warning" "$line_width" >&2
        truncate_line "⚠️  $BACKEND_PERMISSION_WARNING" "$line_width" >&2
        truncate_line "⚠️  For safer execution, use the provided devcontainer." "$line_width" >&2
        echo "" >&2

        # Interactive opt-out. Only prompt when attached to a terminal and not
        # auto-confirmed; non-interactive callers (CI, cron, /loop, tests)
        # proceed as before. Dry-run executes nothing dangerous, so never prompts.
        if ! $assume_yes && ! $dry_run && [[ -t 0 ]]; then
            printf 'Continue anyway? [y/N] ' >&2
            local reply=''
            read -r reply
            if [[ ! "$reply" =~ ^[Yy] ]]; then
                echo 'Aborted.' >&2
                exit 1
            fi
        fi
    fi

    local iteration=0
    local consecutive_noops=0

    # Clean exit on interrupt signals
    trap 'echo -e "\nInterrupted at iteration $iteration / $max_iterations" >&2; exit 130' SIGINT SIGTERM

    while [[ $iteration -lt $max_iterations ]]; do
        iteration=$((iteration + 1))
        local iter_label=" ITERATION $iteration / $max_iterations "
        local pad_total=$((line_width - ${#iter_label}))
        local pad_left=$((pad_total / 2))
        local pad_right=$((pad_total - pad_left))
        printf '\n%s%s%s\n\n' \
            "$(printf '%*s' "$pad_left" '' | tr ' ' '=')" \
            "$iter_label" \
            "$(printf '%*s' "$pad_right" '' | tr ' ' '=')"

        # Announce the iteration's target up front — the loop is otherwise
        # silent until the backend finishes. Build mode works the plan top
        # down, so the first incomplete entry is what this iteration will
        # attempt; re-read each iteration because the previous one moves it.
        if [[ "$mode" == "build" ]]; then
            local next_item
            # An unreadable plan must not abort the loop: announcing is a
            # convenience, so fall back to silence rather than failing.
            next_item=$(next_plan_item) || next_item=""
            if [[ -n "$next_item" ]]; then
                truncate_line "Next:    $next_item" "$line_width"
                echo ""
            fi
        fi

        # Snapshot HEAD to detect noops. Plan mode never commits, so it
        # fingerprints the artifacts it is allowed to change instead.
        local head_before plan_state_before="" plan_state_after=""
        head_before=$(git rev-parse HEAD)
        if [[ "$mode" == "plan" ]]; then
            plan_state_before=$(plan_state_hash)
        fi

        # Snapshot metrics baseline for this iteration
        local iter_start plan_done_before=0
        iter_start=$(date +%s)
        if [[ -f "IMPLEMENTATION_PLAN.md" ]]; then
            plan_done_before=$(plan_items_body | grep -c '^- \[x\]' || true)
        fi

        # Inject {{GOAL}} into prompt using bash substitution
        local prompt
        prompt=$(<"$prompt_file")
        prompt="${prompt//\{\{GOAL\}\}/${goal:-No specific goal provided}}"

        if $dry_run; then
            if [[ "$BACKEND_STDIN_PROMPT" == "true" ]]; then
                echo "[dry-run] Would run: ${BACKEND_CMD[*]}"
            else
                echo "[dry-run] Would run: ${BACKEND_CMD[*]} <prompt>"
            fi
            echo "[dry-run] Prompt content ($prompt_file with goal substituted):"
            echo "$prompt"
        else
            # Verbose: print backend command before execution
            if $verbose; then
                if [[ "$BACKEND_STDIN_PROMPT" == "true" ]]; then
                    echo "[verbose] Backend command: ${BACKEND_CMD[*]}" >&2
                else
                    local truncated_prompt="$prompt"
                    if [[ ${#truncated_prompt} -gt 200 ]]; then
                        truncated_prompt="${truncated_prompt:0:200}..."
                    fi
                    echo "[verbose] Backend command: ${BACKEND_CMD[*]} $truncated_prompt" >&2
                fi
            fi

            # Run backend command separately, capturing stdout while preserving
            # stderr. On a non-zero exit, retry the same iteration if the
            # output looks like a rate/usage-limit failure with a parseable
            # reset time — backend CLIs use the same exit code for every
            # failure type (see anthropics/claude-code#35540), so
            # classification reads the raw stream content, before jq ever
            # sees it. A rate-limit-shaped failure with no parseable reset
            # time fails immediately rather than guessing a wait.
            local backend_output="" backend_exit=0
            local retry_num=0
            while true; do
                backend_exit=0
                local stderr_capture
                stderr_capture=$(mktemp)

                if [[ "$BACKEND_STDIN_PROMPT" == "true" ]]; then
                    backend_output=$(echo "$prompt" | "${BACKEND_CMD[@]}" 2> >(
                        if $verbose; then
                            echo "[verbose] === Backend stderr ===" >&2
                            tee "$stderr_capture" >&2
                            echo "[verbose] === End backend stderr ===" >&2
                        else
                            tee "$stderr_capture" >&2
                        fi
                    )) || backend_exit=$?
                else
                    backend_output=$("${BACKEND_CMD[@]}" "$prompt" 2> >(
                        if $verbose; then
                            echo "[verbose] === Backend stderr ===" >&2
                            tee "$stderr_capture" >&2
                            echo "[verbose] === End backend stderr ===" >&2
                        else
                            tee "$stderr_capture" >&2
                        fi
                    )) || backend_exit=$?
                fi

                local backend_stderr
                backend_stderr=$(<"$stderr_capture")
                rm -f "$stderr_capture"

                [[ $backend_exit -eq 0 ]] && break

                local combined="$backend_output"$'\n'"$backend_stderr"
                if ! is_rate_limit_failure "$combined"; then
                    echo "Error: backend command failed on iteration $iteration (exit code $backend_exit)" >&2
                    echo "Raw backend output:" >&2
                    echo "$backend_output" >&2
                    echo "Hint: re-run with --dry-run to inspect the prompt, or --verbose for full diagnostics" >&2
                    exit "$backend_exit"
                fi

                local reset_epoch
                reset_epoch=$(extract_reset_epoch "$combined")
                if [[ -z "$reset_epoch" ]]; then
                    echo "Error: backend command failed on iteration $iteration (exit code $backend_exit)" >&2
                    echo "This looks rate limited, but no reset time could be parsed from the output —" >&2
                    echo "failing instead of guessing a wait. Please report this so detection can be fixed." >&2
                    echo "Raw backend output:" >&2
                    echo "$backend_output" >&2
                    echo "Hint: re-run with --dry-run to inspect the prompt, or --verbose for full diagnostics" >&2
                    exit "$backend_exit"
                fi

                if [[ $retry_num -ge $max_retries ]]; then
                    echo "Error: backend command failed on iteration $iteration (exit code $backend_exit)" >&2
                    if [[ $max_retries -eq 0 ]]; then
                        echo "Rate limited with a parseable reset time, but retries are disabled (--no-retry / --max-retries-per-iteration 0)." >&2
                    else
                        echo "Rate limited — exhausted $max_retries retries, each with a valid reset time." >&2
                    fi
                    echo "Raw backend output:" >&2
                    echo "$backend_output" >&2
                    echo "Hint: re-run with --dry-run to inspect the prompt, or --verbose for full diagnostics" >&2
                    exit "$backend_exit"
                fi

                retry_num=$((retry_num + 1))
                local wait_seconds
                wait_seconds=$(compute_retry_wait "$reset_epoch")
                echo "⏸ Rate limited on iteration $iteration, retrying in $(format_duration "$wait_seconds") (attempt $retry_num/$max_retries)" >&2
                sleep "$wait_seconds"
            done

            # Verbose: show raw backend output before jq
            if $verbose; then
                echo "[verbose] Raw backend output:" >&2
                echo "$backend_output" >&2
            fi

            # Run jq separately on captured output
            local jq_output=""
            local jq_exit=0
            jq_output=$(echo "$backend_output" | jq "${BACKEND_JQ_FLAGS[@]}" "$BACKEND_JQ_FILTER") || jq_exit=$?

            if [[ $jq_exit -ne 0 ]]; then
                echo "Error: jq parse failure on iteration $iteration (exit code $jq_exit)" >&2
                echo "Hint: re-run with --verbose to see raw backend output before jq processing" >&2
                exit "$jq_exit"
            fi

            # Verbose: show exit codes
            if $verbose; then
                echo "[verbose] Exit codes — backend: $backend_exit, jq: $jq_exit" >&2
            fi

            # Print jq output (unchanged behaviour)
            echo "$jq_output"

            # Fingerprint the plan artifacts after the pass. Plan mode uses this
            # instead of HEAD for both the metrics noop flag and convergence.
            local plan_noop=""
            if [[ "$mode" == "plan" ]]; then
                plan_state_after=$(plan_state_hash)
                if [[ "$plan_state_before" == "$plan_state_after" ]]; then
                    plan_noop=true
                else
                    plan_noop=false
                fi
            fi

            # Record iteration metrics; a failure here warns but never
            # interrupts the loop.
            if $metrics_enabled; then
                local iter_end raw_file head_after_m
                # Fallbacks keep the never-interrupt-the-loop contract even if
                # date or git fail mid-run (worst case: zero-length iteration /
                # activity attributed as noop).
                iter_end=$(date +%s) || iter_end=$iter_start
                raw_file="$metrics_dir/$(printf 'iter-%03d' "$iteration").stream.jsonl"
                printf '%s\n' "$backend_output" > "$raw_file" 2>/dev/null || true
                head_after_m=$(git rev-parse HEAD 2>/dev/null) || head_after_m=$head_before
                if write_iteration_metrics "$metrics_file" "$raw_file" "$mode" \
                    "$current_branch" "$BACKEND_NAME" "$model" "$iteration" \
                    "$iter_start" "$iter_end" "$head_before" "$head_after_m" \
                    "$plan_done_before" "$plan_noop"; then
                    echo ""
                    truncate_line "Metrics: $(fmt_duration $((iter_end - iter_start))) wall$(metrics_summary_suffix "$metrics_file")" "$line_width"
                else
                    echo "Warning: metrics capture failed for iteration $iteration" >&2
                fi
            fi
        fi

        # Push changes after each iteration. Plan and review modes produce no
        # commits (their artifacts are gitignored), so there is nothing to push.
        if [[ "$mode" == "build" ]]; then
            if $dry_run; then
                echo "[dry-run] Would run: git push origin $current_branch"
            elif ! $skip_push; then
                local push_output
                if ! push_output=$(git push origin "$current_branch" 2>&1); then
                    if echo "$push_output" | grep -q "has no upstream branch"; then
                        echo "No upstream branch found. Setting upstream..."
                        git push -u origin "$current_branch"
                    else
                        echo "Push failed:" >&2
                        echo "$push_output" >&2
                        exit 1
                    fi
                elif $verbose; then
                    echo "[verbose] Push output:" >&2
                    echo "$push_output" >&2
                fi
            fi
        fi

        # Early exit, per mode.
        #
        # Build mode watches HEAD and tolerates one noop; -n overrides it.
        #
        # Plan mode never commits (IMPLEMENTATION_PLAN.md is gitignored), so it
        # watches the plan artifacts instead. A pass that changes nothing has
        # converged, and there is no second-chance iteration to wait for: -n caps
        # a plan run but never disables the check.
        #
        # Review mode has no early exit at all. It is read-only by design — it
        # writes REVIEW.md and never commits — so every iteration is a noop by
        # HEAD, and a HEAD-based check would cut a multi-pass review short for
        # doing exactly what it is supposed to do. Each condition below names its
        # mode explicitly rather than treating one as the default.
        #
        # Convergence requires at least one item to converge on. A pass that
        # changes nothing against an empty plan is a planning failure — the
        # backend answered without doing the work — and is indistinguishable
        # from real convergence by the fingerprint alone. Failing here stops a
        # run that would otherwise report success and leave 'ralph build' with
        # nothing to do.
        if ! $dry_run; then
            if [[ "$mode" == "plan" ]]; then
                if [[ "$plan_state_before" == "$plan_state_after" ]]; then
                    if [[ "$(plan_items_body | grep -c '^- \[' || true)" -eq 0 ]]; then
                        echo "Error: pass $iteration changed nothing and IMPLEMENTATION_PLAN.md holds no items." >&2
                        echo "The planning agent produced no plan. Check the backend output above; re-run 'ralph plan' once the cause is fixed." >&2
                        exit 1
                    fi
                    echo -e "\nPlan converged — pass $iteration changed nothing. Exiting early."
                    break
                fi
            elif [[ "$mode" == "build" ]] && ! $hard_override; then
                local head_after
                head_after=$(git rev-parse HEAD)
                if [[ -z "$(build_progress_paths "$head_before" "$head_after")" ]]; then
                    consecutive_noops=$((consecutive_noops + 1))
                    if [[ $consecutive_noops -ge 2 ]]; then
                        echo -e "\nNo changes detected for 2 consecutive iterations — exiting early."
                        break
                    fi
                else
                    consecutive_noops=0
                fi
            fi
        fi
    done

    echo -e "\nCompleted $iteration iterations."
    if $metrics_enabled && [[ -s "$metrics_file" ]]; then
        echo "Metrics recorded: $metrics_file (summarise with 'ralph metrics')"
    fi
}

# Main dispatch
case "${1:-}" in
    sandbox)           shift; cmd_sandbox "$@" ;;
    plan|build|review) cmd_loop "$@" ;;
    metrics)    shift; cmd_metrics "$@" ;;
    init)       shift; cmd_init "$@" ;;
    clean)      cmd_clean ;;
    archive)    cmd_archive ;;
    version)    cmd_version ;;
    -h|--help)  usage ;;
    "")         usage ;;
    *)          echo "Error: unknown command '$1'"; exit 1 ;;
esac
