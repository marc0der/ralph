#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"
CONFIG_DIR="${RALPH_CONFIG_DIR:-$HOME/.config/ralph}"

# Safety-net cap for plan mode; a plan run normally ends on convergence,
# well before this (build mode calculates its own count from the plan)
PLAN_DEFAULT_CAP=6

ARTIFACTS=(IMPLEMENTATION_PLAN.md PROGRESS.md PROMPT_plan.md PROMPT_build.md PROMPT_review.md)
ARCHIVE_DIR=".ralph"

# Absolute path of the running script, resolved once before any command can
# chdir, so `auto` can invoke each phase as a child of itself (§4). Follows
# symlinks portably (macOS has no `readlink -f`); PATH lookup already hands the
# resolved path to $0.
RALPH_SELF="${BASH_SOURCE[0]}"
while [[ -L $RALPH_SELF ]]; do
    _ralph_dir=$(cd -P "$(dirname "$RALPH_SELF")" && pwd)
    RALPH_SELF=$(readlink "$RALPH_SELF")
    [[ $RALPH_SELF != /* ]] && RALPH_SELF="$_ralph_dir/$RALPH_SELF"
done
RALPH_SELF="$(cd -P "$(dirname "$RALPH_SELF")" && pwd)/$(basename "$RALPH_SELF")"

# `auto` lifecycle state (specs/auto-lifecycle.md §5, §2).
# shellcheck disable=SC2034  # Consumed by cmd_auto in a later change.
AUTO_STATE_FILE="$ARCHIVE_DIR/auto-state"
# shellcheck disable=SC2034  # Consumed by cmd_auto in a later change.
RALPH_PHASES=(archive init plan build review build)
# shellcheck disable=SC2034  # Consumed by cmd_auto in a later change.
RESUME_FLOOR=3

# Path of the per-run raw stream temp file, or empty when there is none.
# Script-scoped so the EXIT trap can read it after cmd_loop's locals are gone,
# which lets the trap defer expansion instead of baking the path into its body.
RALPH_TEMP_STREAM=""

# --- Backend definitions ---
# Each backend_<name> function sets well-known variables and defines
# build_backend_cmd(model) which populates the BACKEND_CMD array.
# Adding a new backend only requires a new function and a SUPPORTED_BACKENDS entry.

SUPPORTED_BACKENDS=(claude codex copilot pi)

# Prepended by cmd_loop to every BACKEND_JQ_LIVE filter, so each backend's
# live renderer stays a single expression instead of repeating these helpers.
# shellcheck disable=SC2034,SC2016  # Consumed in cmd_loop; $n is a jq variable
JQ_LIVE_PRELUDE='
def trim($n): if (. | length) > $n then .[0:$n] + "\u2026" else . end;
def oneline: gsub("\\s+"; " ");
'

# shellcheck disable=SC2034  # Variables are set here and consumed in cmd_loop
backend_claude() {
    BACKEND_NAME="claude"
    BACKEND_CLI="claude"
    BACKEND_DEFAULT_MODEL="opus"
    BACKEND_PERMISSION_FLAG="--dangerously-skip-permissions"
    BACKEND_PERMISSION_WARNING="Claude will have unrestricted access to tools (file writes, shell commands, etc)."
    BACKEND_JQ_FLAGS=(-r)
    BACKEND_JQ_FILTER='select(.type == "result") | .result // empty'
    # Live progress renderer: one short line per interesting stream-json event.
    # A raise here is swallowed by the renderer's 2>/dev/null and discards the
    # remaining content items of the event, not only the offending one. `//`
    # substitutes null and false only, so it does not guard a wrong type: every
    # rendered value passes through tostring and every iteration tests its type.
    # shellcheck disable=SC2016  # $n is a jq variable from JQ_LIVE_PRELUDE
    BACKEND_JQ_LIVE='
if .type == "assistant" then
    (if (.message.content? | type) == "array" then .message.content[] else empty end)
    | if .type == "tool_use" then
        "  \u2192 " + ((.name // "?") | tostring) + " "
          + (((.input // {}) | if type == "object" then
               (.command // .file_path // .path // .pattern // tostring) else . end)
             | tostring | trim(100) | oneline)
      elif .type == "text" then
        ((.text // "") | tostring | trim(300) | oneline) | if . == "" then empty else "  " + . end
      else empty end
elif .type == "result" then
    "  [result] " + ((.subtype // "?") | tostring) + " \u00b7 "
      + ((((.duration_ms // 0) | tonumber? // 0) / 1000 | round) | tostring) + "s"
else empty end'
    BACKEND_STDIN_PROMPT=true
    # shellcheck disable=SC2317,SC2329  # Invoked indirectly via resolve_backend
    build_backend_cmd() {
        local model="$1"
        BACKEND_CMD=(claude -p "$BACKEND_PERMISSION_FLAG" --output-format=stream-json --model "$model" --verbose)
    }
}

# shellcheck disable=SC2034  # Variables are set here and consumed in cmd_loop
backend_codex() {
    BACKEND_NAME="codex"
    BACKEND_CLI="codex"
    BACKEND_DEFAULT_MODEL="gpt-5.2-codex"
    BACKEND_PERMISSION_FLAG="--dangerously-bypass-approvals-and-sandbox"
    BACKEND_PERMISSION_WARNING="Codex will have unrestricted access to tools (file writes, shell commands, etc)."
    BACKEND_JQ_FLAGS=(-rs)
    BACKEND_JQ_FILTER='(map(select(.item.type == "agent_message")) | last | .item.text // null) // ([ .[] | select(.item.type == "command_execution" and .item.status == "completed") | "$ " + .item.command + "\n" + (.item.aggregated_output // "") ] | join("\n") | if . == "" then null else . end) // empty'
    # No live renderer yet. The assignment is not decoration: cmd_loop reads
    # this variable unguarded, so leaving it unset would let an exported
    # BACKEND_JQ_LIVE from the environment pick this backend's code path.
    BACKEND_JQ_LIVE=""
    BACKEND_STDIN_PROMPT=false
    # shellcheck disable=SC2317,SC2329  # Invoked indirectly via resolve_backend
    build_backend_cmd() {
        local model="$1"
        BACKEND_CMD=(codex exec "$BACKEND_PERMISSION_FLAG" --json --model "$model")
    }
}

# shellcheck disable=SC2034  # Variables are set here and consumed in cmd_loop
backend_copilot() {
    BACKEND_NAME="copilot"
    BACKEND_CLI="copilot"
    BACKEND_DEFAULT_MODEL="claude-sonnet-4.6"
    BACKEND_PERMISSION_FLAG="--yolo"
    BACKEND_PERMISSION_WARNING="Copilot will have unrestricted access to tools (file writes, shell commands, etc)."
    BACKEND_JQ_FLAGS=(-rs)
    BACKEND_JQ_FILTER='(map(select(.type == "assistant.message")) | last | .data.content // null) // ([ .[] | select(.type == "tool.execution_complete" and .data.success == true) | (.data.result.content // .data.result.detailedContent // "") ] | join("\n") | if . == "" then null else . end) // empty'
    # No live renderer yet; assigned for the same reason as backend_codex.
    BACKEND_JQ_LIVE=""
    BACKEND_STDIN_PROMPT=false
    # shellcheck disable=SC2317,SC2329  # Invoked indirectly via resolve_backend
    build_backend_cmd() {
        local model="$1"
        BACKEND_CMD=(copilot --output-format=json "$BACKEND_PERMISSION_FLAG" --model "$model" -p)
    }
}

# shellcheck disable=SC2034  # Variables are set here and consumed in cmd_loop
backend_pi() {
    BACKEND_NAME="pi"
    BACKEND_CLI="pi"
    # Pi's default provider is google, so a bare 'opus' would resolve there;
    # pin the fully-qualified provider/id to land on Anthropic.
    BACKEND_DEFAULT_MODEL="anthropic/claude-opus-4-8"
    # Pi has no permission flag — its built-in tools run without prompting,
    # so build_backend_cmd omits the positional entirely (no stray empty arg).
    BACKEND_PERMISSION_FLAG=""
    BACKEND_PERMISSION_WARNING="Pi will have unrestricted access to tools (file writes, shell commands, etc)."
    BACKEND_JQ_FLAGS=(-rs)
    # Two-stage filter over the LAST agent_end event (auto-retry can emit more
    # than one). Primary: its last role=="assistant" message, joined text of
    # every type=="text" content item. Fallback: transcript from .messages —
    # each role=="toolResult" with isError==false, concatenating text content,
    # prefixed with "$ <command>" for the bash tool (command looked up from the
    # matching assistant toolCall content item by toolCallId). Empty otherwise.
    # shellcheck disable=SC2016  # $ae/$calls/$text are jq variables, not shell
    BACKEND_JQ_FILTER='(map(select(.type == "agent_end")) | last) as $ae | ([($ae.messages // [])[] | select(.role == "assistant")] | last | (.content // []) | map(select(.type == "text") | .text) | join("") | if . == "" then null else . end) // (([($ae.messages // [])[] | select(.role == "assistant") | (.content // [])[] | select(.type == "toolCall") | {key: .id, value: .}] | from_entries) as $calls | [($ae.messages // [])[] | select(.role == "toolResult" and .isError == false) | ((.content // []) | map(select(.type == "text") | .text) | join("")) as $text | if .toolName == "bash" then "$ " + ($calls[.toolCallId].arguments.command // "") + "\n" + $text else $text end] | join("\n") | if . == "" then null else . end) // empty'
    # Live progress renderer. pi emits ~40 events per trivial task, including a
    # flood of message_update usage snapshots; those fall through to empty. The
    # standalone tool_execution_start event carries toolName/args flat on itself,
    # unlike the toolCall content items the summary filter reads.
    # shellcheck disable=SC2016  # $n is a jq variable from JQ_LIVE_PRELUDE
    BACKEND_JQ_LIVE='
if .type == "tool_execution_start" then
    "  \u2192 " + ((.toolName // "?") | tostring) + " "
      + (((.args // {}) | if type == "object" then
           (.command // .file_path // .path // .pattern // tostring) else . end)
         | tostring | trim(100) | oneline)
elif .type == "message_end" and .message.role == "assistant" then
    ((if (.message.content? | type) == "array" then .message.content else [] end)
      | map(select(.type == "text") | .text // "" | tostring) | join(" ")
      | trim(300) | oneline) | if . == "" then empty else "  " + . end
elif .type == "turn_start" then "  ---"
else empty end'
    BACKEND_STDIN_PROMPT=true
    # shellcheck disable=SC2317,SC2329  # Invoked indirectly via resolve_backend
    build_backend_cmd() {
        local model="$1"
        BACKEND_CMD=(pi -p --mode json --model "$model" --no-session)
    }
}

# --- Utilities ---

# Hash stdin. Linux ships md5sum, macOS ships md5.
md5_hash() {
    if command -v md5sum &>/dev/null; then
        md5sum | cut -d' ' -f1
    elif command -v md5 &>/dev/null; then
        md5
    else
        echo "Error: no md5sum or md5 command found — install coreutils" >&2
        return 1
    fi
}

resolve_backend() {
    local name="$1"
    local found=false
    for b in "${SUPPORTED_BACKENDS[@]}"; do
        if [[ "$b" == "$name" ]]; then
            found=true
            break
        fi
    done
    if ! $found; then
        echo "Error: unknown backend '$name'" >&2
        echo "Supported backends: ${SUPPORTED_BACKENDS[*]}" >&2
        exit 1
    fi
    "backend_${name}"
}

usage() {
    cat <<'EOF'
ralph — autonomous AI coding agent loop runner

Usage:
  ralph sandbox [--rebuild]
  ralph sandbox clean
  ralph <plan|build|review> [options]
  ralph auto [options]
  ralph init
  ralph clean
  ralph archive
  ralph metrics [file]
  ralph version

Modes:
  sandbox        Enter a devcontainer shell for the current project
  sandbox clean  Remove the devcontainer for the current project
  plan           Analyse specs and source, create/update IMPLEMENTATION_PLAN.md
  build          Pick the next item, implement, test, commit, push
  review         Audit the cycle's specs against the code, file findings as new plan items
  auto           Run the whole lifecycle: archive, init, plan, build, review, build
  init           Initialise workspace (PROGRESS.md, IMPLEMENTATION_PLAN.md, specs/)
  clean          Delete IMPLEMENTATION_PLAN.md and PROGRESS.md
  archive        Move IMPLEMENTATION_PLAN.md and PROGRESS.md to .ralph/<timestamp>/
  metrics        Summarise a run's loop metrics (latest run, or a given metrics.jsonl)

Sandbox options:
      --rebuild        Rebuild the container image from scratch

Init options:
  -p, --prompts      Also copy prompt templates for local customisation

Auto options:
      --resume         Re-enter the lifecycle at the phase in .ralph/auto-state;
                       archive and init never re-run, so repair a failed phase
                       by hand before resuming
      --force          Run outside a container, for a runner already isolated
  auto does not accept -n/--iterations; each phase resolves its own count

Options:
  -n, --iterations N   Max iterations (plan and review default: 6, build:
                       calculated from the plan). In build mode this also
                       disables the noop exit; in plan and review modes it caps
                       the run but never disables the convergence exit
  -g, --goal TEXT      Goal to inject into the prompt template (plan and auto only; required)
  -m, --model MODEL    Model to use (default depends on backend)
  -b, --backend NAME   Backend to use: claude, codex, copilot, pi (default: claude)
      --skip-push      Don't push after each build iteration (plan and review
                       never push)
      --dry-run        Print what would be executed without running
      --no-metrics     Don't record per-iteration metrics under .ralph/metrics/
  -v, --verbose        Stream backend activity live; show commands, exit codes and the raw stream path
  -y, --yes            Skip the confirmation when running outside a sandbox
  -h, --help           Show this help message

Examples:
  ralph plan -g specs/checkout-flow.md
  ralph plan -n 2 -g source/svc/specs/FT-008.md
  ralph plan -g "Migrate to hexagonal architecture"
  ralph build -n 10 -m sonnet
  ralph build -b codex
  ralph build --iterations 5
  ralph build && ralph review && ralph build
  ralph review -b codex
  ralph auto -g specs/checkout-flow.md
  ralph sandbox
  ralph sandbox --rebuild
  ralph sandbox clean
  ralph archive
EOF
    exit 0
}

cmd_version() {
    echo "ralph $VERSION"
    exit 0
}

cmd_clean() {
    local found=false
    for file in "${ARTIFACTS[@]}"; do
        [[ "$file" == PROMPT_*.md ]] && continue
        if [[ -f "$file" ]]; then
            rm "$file"
            echo "Deleted: $file"
            found=true
        fi
    done
    $found || echo "Nothing to clean."
}

cmd_archive() {
    local found=false
    for file in "${ARTIFACTS[@]}"; do
        [[ "$file" == PROMPT_*.md ]] && continue
        if [[ -f "$file" ]]; then
            found=true
            break
        fi
    done

    if ! $found; then
        echo "Nothing to archive."
        return
    fi

    local timestamp
    timestamp=$(date +%Y%m%d-%H%M%S)
    local dest="$ARCHIVE_DIR/$timestamp"
    mkdir -p "$dest"

    for file in "${ARTIFACTS[@]}"; do
        [[ "$file" == PROMPT_*.md ]] && continue
        if [[ -f "$file" ]]; then
            mv "$file" "$dest/"
            echo "Archived: $file -> $dest/$file"
        fi
    done
}

cmd_init() {
    local with_prompts=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--prompts) with_prompts=true; shift ;;
            *) echo "Error: unknown init option '$1'"; exit 1 ;;
        esac
    done

    local templates_dir="$CONFIG_DIR/templates"

    if [[ -f "$templates_dir/PROGRESS.md" ]]; then
        scaffold "PROGRESS.md" "$templates_dir/PROGRESS.md"
    else
        echo "Warning: PROGRESS.md template not found at $templates_dir"
    fi

    if [[ -f "$templates_dir/IMPLEMENTATION_PLAN.md" ]]; then
        scaffold "IMPLEMENTATION_PLAN.md" "$templates_dir/IMPLEMENTATION_PLAN.md"
    else
        echo "Warning: IMPLEMENTATION_PLAN.md template not found at $templates_dir"
    fi

    if [[ -d "specs" ]]; then
        echo "Skipped: specs/ already exists"
    else
        mkdir -p "specs"
        echo "Created: specs/"
    fi

    if [[ ! -f ".gitignore" ]]; then
        touch .gitignore
        echo "Created: .gitignore"
    fi
    # Ensure file ends with a newline before appending
    [[ -s .gitignore && $(tail -c1 .gitignore) != "" ]] && echo >> .gitignore
    local ignore_entries=("IMPLEMENTATION_PLAN.md" "PROGRESS.md" ".ralph/" "PROMPT_plan.md" "PROMPT_build.md" "PROMPT_review.md")
    for entry in "${ignore_entries[@]}"; do
        if ! grep -qxF "$entry" .gitignore; then
            echo "$entry" >> .gitignore
            echo "Added to .gitignore: $entry"
        fi
    done

    if $with_prompts; then
        local prompts_dir="$CONFIG_DIR/prompts"
        if [[ ! -d "$prompts_dir" ]]; then
            echo "Error: ralph prompts not found at $prompts_dir"
            echo "Run the installer first: ./install.sh"
            exit 1
        fi
        for file in plan.md build.md review.md; do
            scaffold "PROMPT_${file}" "$prompts_dir/$file"
        done
    fi
}

scaffold() {
    local target="$1"
    local source="$2"
    if [[ -f "$target" ]]; then
        echo "Skipped: $target already exists"
    else
        cp "$source" "$target"
        echo "Created: $target"
    fi
}

cmd_sandbox() {
    local rebuild=false

    case "${1:-}" in
        clean)     sandbox_clean; return ;;
        --rebuild) rebuild=true ;;
        "")        ;;
        *)         echo "Error: unknown sandbox option '$1'" >&2; exit 1 ;;
    esac

    if ! command -v devcontainer >/dev/null 2>&1; then
        echo "Error: 'devcontainer' CLI not found in PATH." >&2
        echo "Install it with: npm install -g @devcontainers/cli" >&2
        exit 1
    fi

    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Error: not inside a git repository." >&2
        exit 1
    fi

    # A submodule worktree's `.git` is a file containing a relative gitdir
    # pointer (e.g. `gitdir: ../../.git/modules/foo`). Bind-mounting the
    # workspace at /workspace in the container leaves the pointer unchanged,
    # so it resolves to a path that doesn't exist inside the container and
    # every subsequent git command — including devcontainer's own
    # postStartCommand — fails. Reject early with actionable guidance.
    if [[ -f .git && ! -d .git ]]; then
        echo "Error: workspace is a git submodule, which is not supported as a sandbox root." >&2
        echo "The submodule's .git pointer is relative to the parent repo and does not" >&2
        echo "resolve inside the container. Run ralph from the parent repository, or clone" >&2
        echo "the submodule's remote URL as a standalone repository." >&2
        exit 1
    fi

    local config="$CONFIG_DIR/container/devcontainer.json"
    if [[ ! -f "$config" ]]; then
        echo "Error: devcontainer config not found at $config" >&2
        echo "Run the installer first: ./install.sh" >&2
        exit 1
    fi

    mkdir -p "$HOME/.claude" "$HOME/.codex" "$HOME/.copilot" "$HOME/.pi/agent"

    local mounts=()
    local ralph_bin
    ralph_bin="$(command -v ralph)"
    mounts+=("type=bind,source=$ralph_bin,target=/usr/local/bin/ralph")
    mounts+=("type=bind,source=$CONFIG_DIR,target=/home/node/.config/ralph")

    if [[ -d "$HOME/.ssh" ]]; then
        mounts+=("type=bind,source=$HOME/.ssh,target=/home/node/.ssh")
    fi
    if [[ -d "$HOME/.config/gh" ]]; then
        mounts+=("type=bind,source=$HOME/.config/gh,target=/home/node/.config/gh")
    fi
    if [[ -d "$HOME/.codex" ]]; then
        mounts+=("type=bind,source=$HOME/.codex,target=/home/node/.codex")
    fi
    if [[ -d "$HOME/.copilot" ]]; then
        mounts+=("type=bind,source=$HOME/.copilot,target=/home/node/.copilot")
    fi
    if [[ -d "$HOME/.pi" ]]; then
        mounts+=("type=bind,source=$HOME/.pi,target=/home/node/.pi")
    fi

    local ssh_env=()
    if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
        mounts+=("type=bind,source=$SSH_AUTH_SOCK,target=/tmp/ssh-agent.sock")
        ssh_env=("--remote-env" "SSH_AUTH_SOCK=/tmp/ssh-agent.sock")
    fi

    # GPG agent forwarding — lets the build loop sign commits with the host key
    # without copying any private key material into the container. The host
    # gpg-agent holds the secret; the container's gpg reaches it over the
    # forwarded socket and reads the mounted public keyring. Prefer the agent's
    # restricted "extra" socket, falling back to the standard socket.
    if command -v gpgconf >/dev/null 2>&1; then
        local gpg_sock gpg_home
        gpg_sock="$(gpgconf --list-dirs agent-extra-socket 2>/dev/null)"
        [[ -S "$gpg_sock" ]] || gpg_sock="$(gpgconf --list-dirs agent-socket 2>/dev/null)"
        if [[ -S "$gpg_sock" ]]; then
            mounts+=("type=bind,source=$gpg_sock,target=/home/node/.gnupg/S.gpg-agent")
            gpg_home="$(gpgconf --list-dirs homedir 2>/dev/null)"
            if [[ -f "$gpg_home/pubring.kbx" ]]; then
                # The devcontainer CLI's --mount only accepts type/source/target
                # (and optional external); it rejects a `readonly` key, unlike
                # the static mounts in devcontainer.json.
                mounts+=("type=bind,source=$gpg_home/pubring.kbx,target=/home/node/.gnupg/pubring.kbx")
            fi
        fi
    fi
    if [[ -n "${OPENAI_API_KEY:-}" ]]; then
        ssh_env+=("--remote-env" "OPENAI_API_KEY=$OPENAI_API_KEY")
    fi
    if [[ -n "${OPENROUTER_API_KEY:-}" ]]; then
        ssh_env+=("--remote-env" "OPENROUTER_API_KEY=$OPENROUTER_API_KEY")
    fi
    if [[ -n "${GEMINI_API_KEY:-}" ]]; then
        ssh_env+=("--remote-env" "GEMINI_API_KEY=$GEMINI_API_KEY")
    fi
    if [[ -n "${ANTHROPIC_BASE_URL:-}" ]]; then
        ssh_env+=("--remote-env" "ANTHROPIC_BASE_URL=$ANTHROPIC_BASE_URL")
    fi
    if [[ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]]; then
        ssh_env+=("--remote-env" "ANTHROPIC_AUTH_TOKEN=$ANTHROPIC_AUTH_TOKEN")
    fi
    if [[ -n "${ANTHROPIC_API_KEY+set}" ]]; then
        ssh_env+=("--remote-env" "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}")
    fi
    # Derive a GitHub token from the host keyring when none is exported. gh's
    # secure storage keeps the token in the OS keyring, which the container cannot
    # reach via the ~/.config/gh bind mount; `gh auth token` reads it on the host so
    # it can be forwarded as an env var (highest precedence in gh) below.
    if [[ -z "${GH_TOKEN:-}" && -z "${GITHUB_TOKEN:-}" ]] && command -v gh >/dev/null 2>&1; then
        local gh_token
        gh_token="$(gh auth token 2>/dev/null)" || true
        if [[ -n "$gh_token" ]]; then
            GH_TOKEN="$gh_token"
        else
            echo "Warning: gh is installed but no GitHub token is available (run 'gh auth login'" >&2
            echo "on the host). The sandbox will start without GitHub CLI authentication." >&2
        fi
    fi
    if [[ -n "${GH_TOKEN:-}" ]]; then
        ssh_env+=("--remote-env" "GH_TOKEN=$GH_TOKEN")
    fi
    if [[ -n "${GITHUB_TOKEN:-}" ]]; then
        ssh_env+=("--remote-env" "GITHUB_TOKEN=$GITHUB_TOKEN")
    fi

    # Shell history volume (deterministic per workspace)
    local workspace_hash
    workspace_hash=$(echo -n "$PWD" | md5_hash | cut -c1-12) || return 1
    mounts+=("type=volume,source=ralph-history-${workspace_hash},target=/commandhistory")

    local mount_flags=()
    for mount in "${mounts[@]}"; do
        mount_flags+=("--mount" "$mount")
    done

    local up_args=(
        "--workspace-folder" "$PWD"
        "--config" "$config"
        "${mount_flags[@]}"
        ${ssh_env[@]+"${ssh_env[@]}"}
    )
    if $rebuild; then
        up_args+=("--remove-existing-container" "--build-no-cache")
    fi

    echo "Starting sandbox..."
    devcontainer up "${up_args[@]}"

    devcontainer exec \
        --workspace-folder "$PWD" \
        --config "$config" \
        ${ssh_env[@]+"${ssh_env[@]}"} \
        zsh
}

sandbox_clean() {
    if ! command -v docker >/dev/null 2>&1; then
        echo "Error: 'docker' not found in PATH." >&2
        exit 1
    fi

    local container_id
    container_id=$(docker ps -a --filter "label=devcontainer.local_folder=$PWD" --format '{{.ID}}')

    if [[ -z "$container_id" ]]; then
        echo "No sandbox container found for $PWD"
        return
    fi

    docker rm -f "$container_id" >/dev/null
    echo "Removed sandbox container for $PWD"
}

# Priority: project-local PROMPT_<mode>.md > installed default.
resolve_prompt() {
    local mode="$1"
    local local_file="PROMPT_${mode}.md"
    local default_file="$CONFIG_DIR/prompts/${mode}.md"

    if [[ -f "$local_file" ]]; then
        echo "$local_file"
    elif [[ -f "$default_file" ]]; then
        echo "$default_file"
    else
        echo "Error: no prompt found for mode '$mode'" >&2
        echo "Looked for: $local_file, $default_file" >&2
        echo "Run 'ralph init' to scaffold local prompts, or reinstall with ./install.sh" >&2
        exit 1
    fi
}

# Review needs PROGRESS.md as well as the plan: it writes supersession entries
# there, so the second requirement is real and not symmetry.
require_init_artifacts() {
    local mode="$1"
    local required=()

    case "$mode" in
        plan)  required=(IMPLEMENTATION_PLAN.md) ;;
        build) required=(IMPLEMENTATION_PLAN.md PROGRESS.md) ;;
        review) required=(IMPLEMENTATION_PLAN.md PROGRESS.md) ;;
    esac

    local missing=()
    for f in "${required[@]}"; do
        [[ -f "$f" ]] || missing+=("$f")
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "Error: missing workspace artifacts required for '$mode': ${missing[*]}" >&2
        echo "Run 'ralph init' to scaffold them before running 'ralph $mode'." >&2
        exit 1
    fi
}

# The part of the plan that holds real items. The '## Entry Format' section
# carries a template entry at column zero, which must never count as work.
# Plans without that heading are read whole, so older plans still work.
# shellcheck disable=SC2120  # optional $1 lets callers override the plan path; every in-tree call uses the default
plan_items_body() {
    local file="${1:-IMPLEMENTATION_PLAN.md}"
    if grep -qE '^## Items[[:space:]]*$' "$file" 2>/dev/null; then
        sed -n '/^## Items[[:space:]]*$/,$p' "$file"
    else
        cat "$file"
    fi
}

# Count plan items whose marker matches a grep regex, e.g. '^- \[x\]'.
# Echoes 0 rather than failing when nothing matches, so callers can arithmetic
# on the result unconditionally under 'set -e'.
count_plan_items() {
    plan_items_body | grep -c "$1" || true
}

# Review's anchor set: the distinct 'specs/' paths the plan's items cite, one
# per line. A path is a whole non-space, non-backtick token, so a nested repo's
# 'source/svc/specs/x.md' stays distinct from the root's 'specs/x.md'.
cited_specs() {
    plan_items_body | awk '$1 == "Spec:" {
        n = split($0, token, /[ \t`]+/)
        for (i = 1; i <= n; i++) if (token[i] ~ /specs\//) print token[i]
    }' | LC_ALL=C sort -u
}

# Predicates shared by require_open_items, require_review_preconditions and
# auto's guards, so every caller asks "can this mode run?" the same way.
have_open_items() {
    [[ "$(count_plan_items '^- \[ \]')" -gt 0 ]]
}

have_shipped_items() {
    [[ "$(count_plan_items '^- \[x\]')" -gt 0 ]]
}

have_cited_specs() {
    [[ -n "$(cited_specs)" ]]
}

# Refuse to start a build against a plan with nothing left to do.
# This is a hard stop, not an iteration heuristic: it runs beside
# require_init_artifacts so '-n' cannot bypass it.
require_open_items() {
    if ! have_open_items; then
        echo "Error: no incomplete items in IMPLEMENTATION_PLAN.md. Run 'ralph plan' first." >&2
        exit 1
    fi
}

# Refuse to start a review that has nothing settled to audit.
# Like require_open_items this is a hard stop beside require_init_artifacts, so
# '-n' cannot bypass it. Items marked '[~]' neither anchor nor block a review.
require_review_preconditions() {
    if ! have_shipped_items; then
        echo "Error: no shipped items in IMPLEMENTATION_PLAN.md — nothing to review." >&2
        echo "Review audits '- [x]' items. An already archived plan lives in .ralph/<timestamp>/." >&2
        exit 1
    fi

    # Pass 1 must start from a plan with no open work: review ranks its own
    # findings against each other, never against work it did not derive.
    if have_open_items; then
        echo "Error: IMPLEMENTATION_PLAN.md still holds incomplete items." >&2
        echo "Run 'ralph build' to finish them before running 'ralph review'." >&2
        exit 1
    fi

    # Review measures the tree against the specs the cycle worked from, so an
    # uncited plan leaves it no standard to audit against.
    if ! have_cited_specs; then
        echo "Error: no Spec: field cites a specs/ path in IMPLEMENTATION_PLAN.md." >&2
        echo "Review audits the cycle's specs. Run 'ralph plan' to anchor the items on them." >&2
        exit 1
    fi
}

# Caller must ensure at least one open item exists (see require_open_items).
calculate_build_iterations() {
    local count
    count=$(count_plan_items '^- \[ \]')

    # 20% headroom, rounded up: ceil(count * 1.2)
    echo $(( (count * 6 + 4) / 5 ))
}

# Modes that never commit, so HEAD cannot measure their progress: they snapshot
# the plan fingerprint instead, for both convergence and the metrics noop flag.
# One predicate, so a fourth such mode cannot be wired into two sites of three.
mode_converges_on_plan() {
    case "$1" in
        plan|review) return 0 ;;
        *) return 1 ;;
    esac
}

# Review also reports the size of the anchor set it swept: a clean review
# changes no file and records a metrics line of zeros, which is otherwise
# indistinguishable from a backend that read the prompt and did nothing. Ralph
# counts the cited specs itself rather than trusting the agent's own claim.
convergence_message() {
    local mode="$1" iteration="$2"
    if [[ "$mode" == "review" ]]; then
        echo "Review converged — pass $iteration found nothing new. Audited $(cited_specs | grep -c '^' || true) specs."
    else
        echo "Plan converged — pass $iteration changed nothing. Exiting early."
    fi
}

# Fingerprint the artifacts a plan iteration is allowed to change.
# Plan mode never commits (IMPLEMENTATION_PLAN.md is gitignored), so HEAD cannot
# detect progress. A pass that leaves this hash unchanged has converged.
plan_state_hash() {
    {
        if [[ -f "IMPLEMENTATION_PLAN.md" ]]; then
            cat "IMPLEMENTATION_PLAN.md"
        fi
        if [[ -d "specs" ]]; then
            # Hash names as well as contents so adding or removing a spec counts
            # as a change. LC_ALL=C keeps the order stable across platforms.
            # -L follows symlinked specs; an unreadable one must not abort the run.
            find -L specs -type f | LC_ALL=C sort | while IFS= read -r spec; do
                echo "$spec"
                cat -- "$spec" || true
            done
        fi
    } 2>/dev/null | md5_hash
}

# List every git repository beneath the working directory with its HEAD.
# A build iteration commits into a nested repository without moving the
# workspace HEAD, so the verdict compares these listings instead. Any
# difference — a moved HEAD, a repository that appeared or vanished — is a
# change. `-prune` keeps find out of the .git directories themselves; it does
# not prune their parents, so a repository nested inside a watched one is
# watched too. `-L` follows symlinked checkouts.
repo_state() {
    local repo
    while IFS= read -r gitpath; do
        repo=${gitpath%/.git}
        # -q --verify is required: plain `rev-parse HEAD` prints "HEAD" on
        # stdout in a commitless repository, so the fallback would append to
        # that output rather than replace it.
        printf '%s %s\n' "$repo" \
            "$(git -C "$repo" rev-parse -q --verify HEAD 2>/dev/null || echo -)"
    done < <(find -L . -maxdepth 6 -name .git -prune -print 2>/dev/null) | LC_ALL=C sort
}

truncate_line() {
    local text="$1" max="$2"
    if [[ ${#text} -gt $max ]]; then
        echo "${text:0:$((max - 3))}..."
    else
        echo "$text"
    fi
}

# --- Metrics capture ---
# Each non-dry-run iteration appends one JSON line to
# .ralph/metrics/<branch>-<run>/metrics.jsonl and retains the raw backend
# stream alongside (iter-NNN.stream.jsonl). Result-event fields (duration,
# turns, cost, token usage) are populated for the claude backend; other
# backends degrade to nulls. A failure here never interrupts the loop.

fmt_duration() {
    local s="$1"
    if [[ -z "$s" || "$s" == "null" ]]; then
        echo "-"
        return
    fi
    if (( s >= 3600 )); then
        printf '%dh%02dm%02ds' $((s / 3600)) $((s % 3600 / 60)) $((s % 60))
    elif (( s >= 60 )); then
        printf '%dm%02ds' $((s / 60)) $((s % 60))
    else
        printf '%ds' "$s"
    fi
}

# Epoch → ISO 8601 UTC; GNU date first, BSD/macOS fallback.
iso_utc() {
    date -u -d "@$1" +%FT%TZ 2>/dev/null || date -u -r "$1" +%FT%TZ
}

write_iteration_metrics() {
    local metrics_file="$1" raw_file="$2" mode="$3" branch="$4" backend="$5" model="$6"
    local iteration="$7" started="$8" ended="$9" head_before="${10}" head_after="${11}" plan_done_before="${12}"
    local noop_override="${13:-}"

    local commits=0 stat="" files="" ins="" del="" noop=true
    if [[ "$head_before" != "$head_after" ]]; then
        noop=false
        commits=$(git rev-list --count "$head_before..$head_after" 2>/dev/null || echo 0)
        stat=$(git diff --shortstat "$head_before" "$head_after" 2>/dev/null || true)
        files=$(sed -nE 's/.* ([0-9]+) files? changed.*/\1/p' <<<"$stat")
        ins=$(sed -nE 's/.* ([0-9]+) insertions?\(\+\).*/\1/p' <<<"$stat")
        del=$(sed -nE 's/.* ([0-9]+) deletions?\(-\).*/\1/p' <<<"$stat")
    fi
    files=${files:-0}; ins=${ins:-0}; del=${del:-0}

    # The workspace HEAD cannot describe every iteration: plan and review never
    # commit, and a build may commit only inside a nested repository. The caller
    # passes the verdict it computed instead. The counts above stay
    # workspace-only.
    if [[ -n "$noop_override" ]]; then
        noop=$noop_override
    fi

    local plan_done_after=0 plan_delta=0
    if [[ -f "IMPLEMENTATION_PLAN.md" ]]; then
        plan_done_after=$(plan_items_body | grep -c '^- \[x\]' || true)
    fi
    plan_delta=$(( plan_done_after - plan_done_before ))
    (( plan_delta < 0 )) && plan_delta=0

    # Backend result-event summary + tool-call histogram (claude stream-json
    # shape; other backends yield nulls and an empty histogram).
    local backend_summary
    backend_summary=$(jq -cs '
        (map(select(.type == "result")) | last // {}) as $r
        | { api_s: (if $r.duration_api_ms then ($r.duration_api_ms / 1000 | round) else null end),
            turns: ($r.num_turns // null),
            cost_usd: ($r.total_cost_usd // null),
            tokens: (if $r.usage then {
                input: ($r.usage.input_tokens // 0),
                output: ($r.usage.output_tokens // 0),
                cache_read: ($r.usage.cache_read_input_tokens // 0),
                cache_write: ($r.usage.cache_creation_input_tokens // 0)
              } else null end),
            session_id: ($r.session_id // null),
            result_status: ($r.subtype // null),
            tools: ([ .[] | select(.type == "assistant") | .message.content[]?
                      | select(.type == "tool_use") | .name ]
                    | group_by(.) | map({key: .[0], value: length}) | from_entries)
          }' "$raw_file" 2>/dev/null) || backend_summary='{}'
    [[ -z "$backend_summary" ]] && backend_summary='{}'

    # Bash applies the append redirection before jq runs and before any
    # 2>/dev/null on that command could cover it, so a metrics directory that
    # was never created leaks `<path>: No such file or directory` from the
    # shell itself — a bare error naming a file the caller already reports as
    # a handled metrics failure. Probe the append inside a brace group, where
    # the redirect error is inside the silenced scope, and let the caller warn.
    if ! { : >> "$metrics_file"; } 2>/dev/null; then
        return 1
    fi

    jq -cn \
        --argjson iteration "$iteration" \
        --arg mode "$mode" --arg branch "$branch" \
        --arg backend "$backend" --arg model "$model" \
        --arg started "$(iso_utc "$started")" \
        --arg ended "$(iso_utc "$ended")" \
        --argjson wall_s "$(( ended - started ))" \
        --argjson commits "$commits" --argjson files "$files" \
        --argjson insertions "$ins" --argjson deletions "$del" \
        --argjson noop "$noop" --argjson plan_done "$plan_delta" \
        --argjson backend_summary "$backend_summary" \
        '{iteration: $iteration, mode: $mode, branch: $branch, backend: $backend,
          model: $model, started: $started, ended: $ended, wall_s: $wall_s}
         + $backend_summary
         + {git: {commits: $commits, files_changed: $files,
                  insertions: $insertions, deletions: $deletions, noop: $noop},
            plan_items_completed: $plan_done}' >> "$metrics_file"
}

# One-line human summary of the last metrics record (everything after the
# wall-clock figure, which the caller prefixes via fmt_duration).
metrics_summary_suffix() {
    local metrics_file="$1"
    tail -n 1 "$metrics_file" | jq -r '
        (if .api_s then " · " + (.api_s | tostring) + "s api" else "" end)
        + (if .turns then " · " + (.turns | tostring) + " turns" else "" end)
        + (if .cost_usd then " · $" + (((.cost_usd * 100 | round) / 100) | tostring) else "" end)
        + " · " + (.git.commits | tostring) + " commits (+" + (.git.insertions | tostring)
        + "/-" + (.git.deletions | tostring) + ")"
        + (if (.tools | length) > 0 then " · " + (.tools | to_entries | sort_by(-.value)
            | map(.key + " " + (.value | tostring)) | join(", ")) else "" end)' 2>/dev/null || true
}

cmd_metrics() {
    local file="${1:-}"
    if [[ -z "$file" ]]; then
        # shellcheck disable=SC2012  # newest-by-mtime needs ls; paths are ralph-generated (no odd filenames)
        file=$(ls -1t "$ARCHIVE_DIR"/metrics/*/metrics.jsonl 2>/dev/null | head -1 || true)
    fi
    if [[ -z "$file" || ! -f "$file" ]]; then
        echo "No metrics found under $ARCHIVE_DIR/metrics/." >&2
        echo "Usage: ralph metrics [path/to/metrics.jsonl]" >&2
        exit 1
    fi

    echo "Run: $file"
    echo ""

    local table
    table=$({
        printf 'ITER\tWALL\tAPI\tTURNS\tCOST\tTOK_IN\tTOK_OUT\tCACHE_RD\tCOMMITS\t+/-\tPLAN\tTOP_TOOLS\n'
        jq -r '
            def fmtd: if . == null then "-"
              elif . >= 3600 then "\(. / 3600 | floor)h\(. % 3600 / 60 | floor)m"
              elif . >= 60 then "\(. / 60 | floor)m\(. % 60)s"
              else "\(.)s" end;
            [ .iteration,
              (.wall_s | fmtd),
              (.api_s | fmtd),
              (.turns // "-"),
              (if .cost_usd then "$\((.cost_usd * 100 | round) / 100)" else "-" end),
              (.tokens.input // "-"), (.tokens.output // "-"), (.tokens.cache_read // "-"),
              .git.commits, "+\(.git.insertions)/-\(.git.deletions)",
              .plan_items_completed,
              ((.tools // {}) | to_entries | sort_by(-.value) | .[0:3]
                | map("\(.key):\(.value)") | join(" ") | if . == "" then "-" else . end)
            ] | @tsv' "$file"
    })
    if command -v column >/dev/null 2>&1; then
        column -t -s $'\t' <<<"$table"
    else
        echo "$table"
    fi

    echo ""
    jq -rs '
        def fmtd: if . == null then "-"
          elif . >= 3600 then "\(. / 3600 | floor)h\(. % 3600 / 60 | floor)m"
          elif . >= 60 then "\(. / 60 | floor)m\(. % 60)s"
          else "\(.)s" end;
        (map(.wall_s) | add) as $wall
        | (map(.api_s // 0) | add) as $api
        | (map(.cost_usd // 0) | add) as $cost
        | "Totals: \(length) iterations · wall \($wall | fmtd) · api \($api | fmtd)"
          + " · turns \(map(.turns // 0) | add)"
          + " · cost $\(($cost * 100 | round) / 100)"
          + " · tokens in \(map(.tokens.input // 0) | add) / out \(map(.tokens.output // 0) | add)"
          + " (cache read \(map(.tokens.cache_read // 0) | add))"
          + " · commits \(map(.git.commits) | add)"
          + " (+\(map(.git.insertions) | add)/-\(map(.git.deletions) | add))"
          + " · plan items \(map(.plan_items_completed) | add)"
          + " · noop iterations \([.[] | select(.git.noop)] | length)"
        ' "$file"
}

cmd_loop() {
    local mode="$1"
    shift

    local max_iterations=""
    local goal=""
    local model=""
    local backend=""
    local skip_push=false
    local dry_run=false
    local verbose=false
    local assume_yes=false
    local no_metrics=false

    ARGS=$(getopt -o n:g:m:b:vyh --long iterations:,goal:,model:,backend:,skip-push,dry-run,no-metrics,verbose,yes,help -n 'ralph' -- "$@")
    eval set -- "$ARGS"

    while true; do
        case "$1" in
            -n|--iterations) max_iterations="$2"; shift 2 ;;
            -g|--goal)
                # specs/meta-repo-hardening.md §12. build and review derive
                # their work from IMPLEMENTATION_PLAN.md, so a goal cannot
                # change what they do. The refusal names the reason; dropping
                # 'g:' from the getopt spec per mode would yield a bare
                # `invalid option -- 'g'` and state none.
                if [[ "$mode" == "build" || "$mode" == "review" ]]; then
                    echo "Error: '$mode' does not accept -g/--goal; the work comes from IMPLEMENTATION_PLAN.md." >&2
                    exit 1
                fi
                goal="$2";           shift 2 ;;
            -m|--model)      model="$2";          shift 2 ;;
            -b|--backend)    backend="$2";        shift 2 ;;
            --skip-push)     skip_push=true;      shift ;;
            --dry-run)       dry_run=true;        shift ;;
            --no-metrics)    no_metrics=true;     shift ;;
            -v|--verbose)    verbose=true;        shift ;;
            -y|--yes)        assume_yes=true;     shift ;;
            -h|--help)       usage ;;
            --)              shift; break ;;
        esac
    done

    # Validate explicit -n value before any state-dependent work, so syntax
    # errors fire regardless of workspace state.
    local hard_override=false
    if [[ -n "$max_iterations" ]]; then
        if [[ ! "$max_iterations" =~ ^[1-9][0-9]*$ ]]; then
            echo "Error: iterations must be a positive integer, got '$max_iterations'" >&2
            exit 1
        fi
        hard_override=true
    fi

    # Fail fast if 'ralph init' hasn't been run — checked before any backend
    # resolution, CLI lookup, or git work so the user gets immediate feedback.
    require_init_artifacts "$mode"

    # Hard stops, checked unconditionally: a plan with no goal has nothing to
    # plan against, a build with no open item has no work to pick up, a review
    # with no shipped item has nothing to audit, and neither '-n' nor
    # '--dry-run' may turn any of the three into a run of empty iterations.
    if [[ "$mode" == "plan" ]]; then
        # specs/meta-repo-hardening.md §12. plan derives its work from the goal;
        # with none it plans against whatever specs/ it happens to resolve,
        # which in a meta repository is the wrong node's.
        if [[ -z "$goal" ]]; then
            echo "Error: 'plan' requires a goal. Pass -g <specification or directory>." >&2
            exit 1
        fi
    elif [[ "$mode" == "build" ]]; then
        require_open_items
    elif [[ "$mode" == "review" ]]; then
        require_review_preconditions
    fi

    backend="${backend:-claude}"
    resolve_backend "$backend"

    if [[ -z "$model" ]]; then
        model="$BACKEND_DEFAULT_MODEL"
    fi

    if ! $hard_override; then
        case "$mode" in
            plan)   max_iterations=$PLAN_DEFAULT_CAP ;;
            build)  max_iterations=$(calculate_build_iterations) ;;
            review) max_iterations=$PLAN_DEFAULT_CAP ;;
        esac
    fi

    if ! $dry_run && ! command -v "$BACKEND_CLI" >/dev/null 2>&1; then
        echo "Error: '$BACKEND_CLI' CLI not found in PATH." >&2
        exit 1
    fi

    if ! command -v git >/dev/null 2>&1; then
        echo "Error: 'git' not found in PATH." >&2
        exit 1
    fi
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Error: not inside a git repository. Run 'git init' first." >&2
        exit 1
    fi

    local prompt_file
    prompt_file=$(resolve_prompt "$mode")

    local current_branch
    current_branch=$(git branch --show-current)

    build_backend_cmd "$model"

    local metrics_enabled=true
    ($dry_run || $no_metrics) && metrics_enabled=false
    local metrics_dir="" metrics_file=""
    if $metrics_enabled; then
        # PID suffix keeps runs started within the same second distinct
        metrics_dir="$ARCHIVE_DIR/metrics/${current_branch//\//-}-$(date +%Y%m%d-%H%M%S)-$$"
        metrics_file="$metrics_dir/metrics.jsonl"
        if ! mkdir -p "$metrics_dir" 2>/dev/null; then
            echo "Warning: cannot create $metrics_dir; metrics disabled for this run" >&2
            metrics_enabled=false
        fi
    fi

    local line_width=120
    local bar
    bar=$(printf '━%.0s' $(seq 1 "$line_width"))

    echo "$bar"
    echo "Mode:    $mode"
    echo "Backend: $BACKEND_NAME"
    truncate_line "Prompt:  $prompt_file" "$line_width"
    echo "Branch:  $current_branch"
    echo "Model:   $model"
    echo "Max:     $max_iterations iterations"
    [[ -n "$goal" ]] && truncate_line "Goal:    $goal" "$line_width"
    $metrics_enabled && truncate_line "Metrics: $metrics_file" "$line_width"
    echo "$bar"

    # Permission handling:
    #   Backends run non-interactively and cannot prompt for tool approval,
    #   so the backend's permission flag is always required.
    #   Inside a devcontainer, network isolation provides additional safety.
    if [[ "${DEVCONTAINER:-false}" != "true" ]]; then
        # Some backends (pi) have no permission flag — drop the "with <flag>"
        # clause so the line doesn't render with a double space or a stray empty arg.
        local first_warning
        if [[ -n "$BACKEND_PERMISSION_FLAG" ]]; then
            first_warning="⚠️  WARNING: Running with $BACKEND_PERMISSION_FLAG outside a container."
        else
            first_warning="⚠️  WARNING: Running outside a container."
        fi
        truncate_line "$first_warning" "$line_width" >&2
        truncate_line "⚠️  $BACKEND_PERMISSION_WARNING" "$line_width" >&2
        truncate_line "⚠️  For safer execution, use the provided devcontainer." "$line_width" >&2
        echo "" >&2

        # Interactive opt-out. Only prompt when attached to a terminal and not
        # auto-confirmed; non-interactive callers (CI, cron, /loop, tests)
        # proceed as before. Dry-run executes nothing dangerous, so never prompts.
        if ! $assume_yes && ! $dry_run && [[ -t 0 ]]; then
            printf 'Continue anyway? [y/N] ' >&2
            local reply=''
            read -r reply
            if [[ ! "$reply" =~ ^[Yy] ]]; then
                echo 'Aborted.' >&2
                exit 1
            fi
        fi
    fi

    local iteration=0
    local consecutive_noops=0

    # Relay backend stderr, wrapping it in markers under --verbose.
    #
    # Every line must go to fd 2. This handler is attached with
    # `2> >(stderr_handler)`, which inherits the backend invocation's stdout —
    # the stream the summary jq filter parses. A line without >&2 would be
    # injected into that stream and break the parse.
    #
    # The verbose branch reads line by line rather than blocking in `cat`, so
    # the markers frame real backend stderr only. Printing them up front framed
    # the live renderer's own output as backend stderr, because both write to
    # fd 2, and a silent backend still produced an empty pair of markers.
    stderr_handler() {
        if $verbose; then
            local line
            local saw_line=false
            while IFS= read -r line || [[ -n "$line" ]]; do
                if ! $saw_line; then
                    echo "[verbose] === Backend stderr ===" >&2
                    saw_line=true
                fi
                printf '%s\n' "$line" >&2
            done
            if $saw_line; then
                echo "[verbose] === End backend stderr ===" >&2
            fi
        else
            cat >&2
        fi
    }

    # Deliver the prompt the way the backend expects and stream stdout to our
    # caller. `printf '%s\n'` rather than `echo`, so a prompt starting with -n
    # or -e reaches the backend verbatim instead of being read as options.
    run_backend() {
        if [[ "$BACKEND_STDIN_PROMPT" == "true" ]]; then
            printf '%s\n' "$prompt" | "${BACKEND_CMD[@]}"
        else
            "${BACKEND_CMD[@]}" "$prompt"
        fi
    }

    # One temp file backs the raw backend stream for the whole run when
    # metrics are off. The template is explicit because argless `mktemp` is a
    # GNU extension that fails on BSD and macOS, which would silently strand
    # every --no-metrics run on the variable-capture branch. mktemp is still
    # allowed to fail: the path then stays empty and the loop degrades rather
    # than aborting under `set -euo pipefail`.
    local temp_stream=""
    temp_stream=$(mktemp "${TMPDIR:-/tmp}/ralph.XXXXXXXXXX" 2>/dev/null) || temp_stream=""

    # Remove the temp file on every exit path. The trap body stays single-quoted
    # so the path is read at exit time from a script-scoped variable: mktemp
    # honours $TMPDIR, and eagerly interpolating that path into the trap lets a
    # single quote in it break the trap (rewriting a clean exit 0 into 2) or a
    # command substitution in it run. This sits alongside the interrupt trap
    # below rather than replacing it, because that trap must keep exiting 130.
    if [[ -n "$temp_stream" ]]; then
        RALPH_TEMP_STREAM="$temp_stream"
        trap 'rm -f -- "$RALPH_TEMP_STREAM"' EXIT
    fi

    trap 'echo -e "\nInterrupted at iteration $iteration / $max_iterations" >&2; exit 130' SIGINT SIGTERM

    while [[ $iteration -lt $max_iterations ]]; do
        iteration=$((iteration + 1))
        local iter_label=" ITERATION $iteration / $max_iterations "
        local pad_total=$((line_width - ${#iter_label}))
        local pad_left=$((pad_total / 2))
        local pad_right=$((pad_total - pad_left))
        printf '\n%s%s%s\n\n' \
            "$(printf '%*s' "$pad_left" '' | tr ' ' '=')" \
            "$iter_label" \
            "$(printf '%*s' "$pad_right" '' | tr ' ' '=')"

        # Snapshot HEAD to detect noops. Plan and review never commit, so they
        # fingerprint the artifacts they are allowed to change instead.
        local head_before plan_state_before="" plan_state_after=""
        local state_before="" state_after=""
        head_before=$(git rev-parse -q --verify HEAD 2>/dev/null || echo -)
        state_before=$(repo_state)
        if mode_converges_on_plan "$mode"; then
            plan_state_before=$(plan_state_hash)
        fi

        # Snapshot the shipped count so the guard after the pass can catch a
        # review that un-ticked an item. Build ticks checkboxes by design, so
        # only review is measured against it.
        local shipped_before=0
        if [[ "$mode" == "review" ]]; then
            shipped_before=$(count_plan_items '^- \[x\]')
        fi

        local iter_start plan_done_before=0
        iter_start=$(date +%s)
        if [[ -f "IMPLEMENTATION_PLAN.md" ]]; then
            plan_done_before=$(plan_items_body | grep -c '^- \[x\]' || true)
        fi

        local prompt
        prompt=$(<"$prompt_file")
        # Both replacements are quoted. From bash 5.2 `patsub_replacement` is
        # on by default, so an unquoted `&` in a replacement expands to the
        # text the pattern matched: a goal of `save & load` would otherwise
        # reach the agent as `save {{GOAL}} load`.
        #
        # `{{GOAL}}` expands first so a goal may itself carry `{{WORKSPACE}}`.
        prompt="${prompt//\{\{GOAL\}\}/"$goal"}"
        prompt="${prompt//\{\{WORKSPACE\}\}/"$PWD"}"

        if $dry_run; then
            if [[ "$BACKEND_STDIN_PROMPT" == "true" ]]; then
                echo "[dry-run] Would run: ${BACKEND_CMD[*]}"
            else
                echo "[dry-run] Would run: ${BACKEND_CMD[*]} <prompt>"
            fi
            echo "[dry-run] Prompt content ($prompt_file with goal and workspace substituted):"
            echo "$prompt"
        else
            # Resolve where this iteration's raw backend stream lands. With
            # metrics on it is retained per iteration for later analysis;
            # otherwise the per-run temp file holds only the current iteration.
            #
            # The file is now the summary filter's only input, so prove it is
            # writable before the backend runs: truncating it also clears the
            # previous iteration on the temp-file path. An unwritable metrics
            # directory degrades to the temp file, and a temp file that also
            # fails leaves raw_file empty, which sends this iteration down the
            # variable-capture path below. A write failure costs one
            # iteration's stream; it never interrupts the loop.
            #
            # The probe redirect sits inside a brace group so 2>/dev/null can
            # reach it. Bash applies redirections left to right, so a bare
            # `! : > "$raw_file" 2>/dev/null` opens the file first and reports
            # the failed open on the still-live fd 2 — the fallback works, but
            # the user sees a shell error naming a file ralph chose not to use.
            local raw_file=""
            if $metrics_enabled; then
                raw_file="$metrics_dir/$(printf 'iter-%03d' "$iteration").stream.jsonl"
            fi
            if [[ -z "$raw_file" ]] || ! { : > "$raw_file"; } 2>/dev/null; then
                raw_file="$temp_stream"
                if [[ -z "$raw_file" ]] || ! { : > "$raw_file"; } 2>/dev/null; then
                    raw_file=""
                fi
            fi

            # Retention decides what a diagnostic may name. A metrics run keeps
            # iter-NNN.stream.jsonl for later analysis; every other path lands
            # on the per-run temp file, which the next iteration truncates and
            # the EXIT trap deletes, so naming it sends the user after bytes
            # that are gone before the prompt returns. Where the file sits
            # decides this, not whether metrics are on: an unwritable metrics
            # directory degrades a metrics-enabled run to that same temp file.
            local stream_retained=false
            if [[ -n "$raw_file" && -n "$metrics_dir" && "$raw_file" == "$metrics_dir/"* ]]; then
                stream_retained=true
            fi

            if $verbose; then
                if [[ "$BACKEND_STDIN_PROMPT" == "true" ]]; then
                    echo "[verbose] Backend command: ${BACKEND_CMD[*]}" >&2
                else
                    local truncated_prompt="$prompt"
                    if [[ ${#truncated_prompt} -gt 200 ]]; then
                        truncated_prompt="${truncated_prompt:0:200}..."
                    fi
                    echo "[verbose] Backend command: ${BACKEND_CMD[*]} $truncated_prompt" >&2
                fi
            fi

            # Stream backend stdout through tee into the raw file. Nothing is
            # held in a shell variable, so every later stage reads the same
            # bytes the backend wrote, in the order it wrote them. With no
            # writable file anywhere, fall back to capturing the stream in a
            # variable for this iteration, so the summary still prints.
            #
            # tee is what keeps a mid-stream write failure — a full disk, a
            # quota, an .ralph directory the agent under test removes — from
            # ending the run. Redirecting the backend's own stdout to the file
            # makes the backend the failing writer, so it dies of SIGXFSZ and a
            # local disk fault is reported as a backend fault. tee absorbs the
            # error instead, keeps draining its input so the backend still
            # reaches its own end, and reports the failure in ${st[1]}.
            #
            # Under --verbose, with a live filter for this backend, tee the
            # stream through jq so each event renders as it arrives. The
            # renderer is hardened: -R with fromjson? skips a non-JSON line
            # instead of aborting, and `|| cat` keeps draining the pipe if jq
            # dies anyway. Either would otherwise SIGPIPE tee and kill the
            # backend mid-iteration, losing every later event and the metrics
            # record. Rendered lines go to fd 2, so stdout still carries only
            # the summary; `>&2` must precede `2>/dev/null` or it duplicates
            # the already-discarded fd 2 and every line is lost.
            #
            # The status comes from PIPESTATUS, not from `|| ...`: `true` is
            # itself a pipeline and would overwrite the array with its own 0.
            # ${st[0]} is the backend on all three branches, and ${st[1]} is
            # tee on the two that write a file. The read of PIPESTATUS must stay
            # textually adjacent to `fi`: any statement in between, even a bare
            # assignment, resets the array to (0) and turns every backend crash
            # into a silent success.
            local backend_exit=0 fallback_output="" st=() stream_write_failed=false
            local live_render_failed=false live_render=false
            # Decide the branch once and record it: the verbose report below
            # keys on whether the renderer ran, and re-deriving that condition
            # there let the two drift apart.
            if [[ -n "$raw_file" ]] && $verbose && [[ -n "$BACKEND_JQ_LIVE" ]]; then
                live_render=true
            fi
            set +e
            if $live_render; then
                run_backend 2> >(stderr_handler) \
                    | tee "$raw_file" \
                    | { jq -rR --unbuffered \
                            "$JQ_LIVE_PRELUDE fromjson? // empty | $BACKEND_JQ_LIVE" \
                            >&2 2>/dev/null || { cat >/dev/null; false; }; }
            elif [[ -n "$raw_file" ]]; then
                run_backend 2> >(stderr_handler) | tee "$raw_file" > /dev/null
            else
                fallback_output=$(run_backend 2> >(stderr_handler))
            fi
            st=("${PIPESTATUS[@]}")
            set -e
            backend_exit=${st[0]}
            # The variable-capture branch runs no tee, so ${st[1]} is unset
            # there and the default keeps `set -u` quiet.
            if [[ ${st[1]:-0} -ne 0 ]]; then
                stream_write_failed=true
            fi
            # ${st[2]} exists only on the live-render branch; the drain in the
            # renderer group ends in `false` so that a jq the filter never
            # compiled — a typo in a future BACKEND_JQ_LIVE, or a jq built
            # without Oniguruma, where `gsub` is absent — is distinguishable
            # from one that rendered every event. Without it the group always
            # reports 0 and a verbose iteration silently prints less than a
            # non-verbose one.
            if [[ ${st[2]:-0} -ne 0 ]]; then
                live_render_failed=true
            fi

            # A short write is a local fault, not a backend fault: the backend
            # reached its own end and only the copy on disk is truncated. Say so
            # and carry on — the iteration keeps its work, and only this
            # iteration's record is incomplete.
            if $stream_write_failed; then
                echo "Warning: raw backend stream write failed on iteration $iteration; $raw_file is truncated" >&2
            fi

            # jq's own diagnostic went to /dev/null, so the loop has to say
            # this itself, or the only symptom is missing output.
            if $live_render_failed; then
                echo "Warning: live rendering failed on iteration $iteration; showing the raw stream from $raw_file instead" >&2
            fi

            # An absent or empty stream is neither a backend failure nor a jq
            # failure, so it warns on its own terms. Both other paths exit;
            # this one carries on. Only a retained stream may be named.
            #
            # The empty-raw_file case warns too. It is the worst degradation —
            # no file was writable anywhere, so this iteration's stream lives
            # only in a shell variable and nothing survives the iteration — yet
            # a guard that required a file name skipped it entirely, and the
            # sole symptom was a metrics record with every backend field absent.
            if [[ -z "$raw_file" ]]; then
                echo "Warning: no writable raw backend stream on iteration $iteration; the stream was held in memory and is not recorded" >&2
            elif [[ ! -s "$raw_file" ]]; then
                if $stream_retained; then
                    echo "Warning: raw backend stream $raw_file is missing or empty after iteration $iteration" >&2
                else
                    echo "Warning: the per-run raw backend stream is missing or empty after iteration $iteration" >&2
                fi
            fi

            # A stream the user has just watched render live needs no second
            # copy: re-printing it only buries the live output. So a verbose
            # iteration prints exactly one form, and rendering decides which.
            #
            # Retention only decides whether that form may name a file. Keying
            # the dump on retention instead made `--no-metrics --verbose` render
            # live *and* dump the same bytes again, which is the one outcome
            # section 7 replaced the dump to avoid.
            #
            # A renderer that never ran (no live filter, as with codex and
            # copilot) or died rendered nothing, so the dump is that
            # iteration's only form.
            local stream_rendered=false stream_pointer=false
            if $live_render && ! $live_render_failed; then
                stream_rendered=true
                if $stream_retained; then
                    stream_pointer=true
                fi
            fi

            if $verbose; then
                if $stream_pointer; then
                    echo "[verbose] Raw stream: $raw_file" >&2
                elif $stream_rendered; then
                    echo "[verbose] Raw stream not retained" >&2
                else
                    echo "[verbose] Raw backend output:" >&2
                    if [[ -n "$raw_file" ]]; then
                        # The stream file can vanish between the write and this
                        # read: an agent that runs `git clean -xfd` or removes
                        # .ralph takes it along, because `ralph init` gitignores
                        # .ralph. An unguarded `cat` under `set -e` would end
                        # the whole run there, with cat's own message as the
                        # only diagnostic. `>&2` sends the dump to stderr first,
                        # so the trailing `2>/dev/null` hides only cat's
                        # complaint, and the loop reports the gap itself.
                        if ! cat "$raw_file" >&2 2>/dev/null; then
                            echo "[verbose] Raw stream unavailable: $raw_file" >&2
                        fi
                    else
                        printf '%s\n' "$fallback_output" >&2
                    fi
                fi
            fi

            # This check runs after the verbose stream output, not before it.
            # A failing iteration is the one whose stream the user most needs,
            # and it is the only iteration that never reaches the code below,
            # so an earlier exit here printed neither the partial stream nor a
            # path to it — --verbose bought nothing on the run it was turned on
            # for. Every statement above only reports; the failure branch stays
            # the first one that ends the run.
            if [[ $backend_exit -ne 0 ]]; then
                echo "Error: backend command failed on iteration $iteration (exit code $backend_exit)" >&2
                # The failing iteration already wrote a partial stream. When the
                # run retains it, that file is the backend's own account of the
                # failure, so name it instead of charging the user another
                # iteration to reproduce bytes already on disk. Advising
                # --verbose is noise once --verbose is on.
                local backend_hint="Hint: re-run with --dry-run to inspect the prompt"
                if $stream_retained; then
                    backend_hint="Hint: inspect the raw backend stream at $raw_file, or re-run with --dry-run to inspect the prompt"
                elif ! $verbose; then
                    backend_hint="$backend_hint, or --verbose for full diagnostics"
                fi
                echo "$backend_hint" >&2
                exit "$backend_exit"
            fi

            local jq_output=""
            local jq_exit=0
            if [[ -n "$raw_file" && -r "$raw_file" ]]; then
                jq_output=$(jq "${BACKEND_JQ_FLAGS[@]}" "$BACKEND_JQ_FILTER" "$raw_file") || jq_exit=$?
            elif [[ -n "$raw_file" ]]; then
                # Same vanished file as the dump above, read a second time. jq
                # would add "Could not open file" and exit 2, and the loop
                # reports that as a parse failure and stops — a local file
                # fault dressed up as a backend fault. The warning already
                # named the file, so summarise nothing and keep going: the next
                # iteration opens a fresh stream.
                jq_output=""
            else
                jq_output=$(printf '%s\n' "$fallback_output" \
                    | jq "${BACKEND_JQ_FLAGS[@]}" "$BACKEND_JQ_FILTER") || jq_exit=$?
            fi

            if [[ $jq_exit -ne 0 ]]; then
                # A truncated stream ends in a partial line, so the summary
                # filter fails on input the backend never produced. Reporting
                # that as a parse failure would stop the run for the same local
                # fault the warning above already reported, so it degrades to an
                # empty summary instead.
                if $stream_write_failed; then
                    echo "Warning: summary parse failed on iteration $iteration (exit code $jq_exit) because the stream write was short" >&2
                    jq_output=""
                else
                    echo "Error: jq parse failure on iteration $iteration (exit code $jq_exit)" >&2
                    # Retention, not the presence of a live filter, decides
                    # whether the stream can be pointed at: -b codex ships no
                    # BACKEND_JQ_LIVE, yet a metrics run still holds every byte
                    # jq choked on. Keying this on stream_pointer asked for a
                    # whole extra backend iteration to reprint that file.
                    if $stream_retained; then
                        echo "Hint: inspect the raw backend stream at $raw_file" >&2
                    elif ! $verbose; then
                        echo "Hint: re-run with --verbose to see raw backend output before jq processing" >&2
                    fi
                    exit "$jq_exit"
                fi
            fi

            if $verbose; then
                echo "[verbose] Exit codes — backend: $backend_exit, jq: $jq_exit" >&2
            fi

            echo "$jq_output"

            # Unconditional: change detection must survive --no-metrics, so this
            # cannot live inside the metrics block below.
            state_after=$(repo_state)

            # Fingerprint the plan artifacts after the pass. The non-committing
            # modes use this instead of HEAD for both the metrics noop flag and
            # convergence.
            local noop_override=""
            if mode_converges_on_plan "$mode"; then
                plan_state_after=$(plan_state_hash)
                if [[ "$plan_state_before" == "$plan_state_after" ]]; then
                    noop_override=true
                else
                    noop_override=false
                fi
            else
                if [[ "$state_before" == "$state_after" ]]; then
                    noop_override=true
                else
                    noop_override=false
                fi
            fi

            # Record iteration metrics; a failure here warns but never
            # interrupts the loop.
            if $metrics_enabled; then
                local iter_end head_after_m
                # Fallbacks keep the never-interrupt-the-loop contract even if
                # date or git fail mid-run (worst case: zero-length iteration).
                iter_end=$(date +%s) || iter_end=$iter_start
                head_after_m=$(git rev-parse -q --verify HEAD 2>/dev/null || echo -)
                # An empty raw_file reaches jq as an empty filename, which it
                # fails to open: `jq -cs` exits 2 under its own 2>/dev/null,
                # backend_summary degrades to `{}`, and the record is written
                # with api_s, turns, cost_usd, tokens, session_id, result_status
                # and tools *absent* rather than null. `ralph metrics` reads
                # that iteration as free, so run cost and token totals come out
                # silently understated. /dev/null slurps to [] instead, which
                # the filter turns into an explicit set of nulls.
                if write_iteration_metrics "$metrics_file" "${raw_file:-/dev/null}" "$mode" \
                    "$current_branch" "$BACKEND_NAME" "$model" "$iteration" \
                    "$iter_start" "$iter_end" "$head_before" "$head_after_m" \
                    "$plan_done_before" "$noop_override"; then
                    echo ""
                    truncate_line "Metrics: $(fmt_duration $((iter_end - iter_start))) wall$(metrics_summary_suffix "$metrics_file")" "$line_width"
                else
                    echo "Warning: metrics capture failed for iteration $iteration" >&2
                fi
            fi

            # Review must never alter a '- [x]' marker (specs/review-phase.md
            # section 4). An un-tick erases the record that the work was
            # committed, hides that a defect escaped, and lets the item
            # oscillate between '[ ]' and '[x]' across review and build runs,
            # which never converges. Stop the run rather than let the next pass
            # audit a plan that already lost an anchor.
            if [[ "$mode" == "review" ]]; then
                local shipped_after
                shipped_after=$(count_plan_items '^- \[x\]')
                if [[ "$shipped_after" -lt "$shipped_before" ]]; then
                    echo "Error: review reduced the shipped item count from $shipped_before to $shipped_after" >&2
                    echo "Review may never un-tick an item. Restore IMPLEMENTATION_PLAN.md before re-running." >&2
                    exit 1
                fi
            fi
        fi

        # Push changes after each iteration. Plan mode produces no commits
        # (IMPLEMENTATION_PLAN.md is gitignored), so there is nothing to push.
        if [[ "$mode" == "build" ]]; then
            if $dry_run; then
                echo "[dry-run] Would run: git push origin $current_branch"
            elif ! $skip_push; then
                if ! git remote get-url origin >/dev/null 2>&1; then
                    echo "No 'origin' remote — skipping push."
                elif ! git rev-parse -q --verify HEAD >/dev/null 2>&1; then
                    echo "No commit on the workspace branch — skipping push."
                else
                    local push_output
                    if ! push_output=$(git push origin "$current_branch" 2>&1); then
                        if echo "$push_output" | grep -q "has no upstream branch"; then
                            echo "No upstream branch found. Setting upstream..."
                            git push -u origin "$current_branch"
                        else
                            echo "Push failed:" >&2
                            echo "$push_output" >&2
                            exit 1
                        fi
                    elif $verbose; then
                        echo "[verbose] Push output:" >&2
                        echo "$push_output" >&2
                    fi
                fi
            fi
        fi

        # Early exit. Build mode watches every git repository beneath the
        # workspace and tolerates one noop; -n overrides it.
        # Plan and review never commit (IMPLEMENTATION_PLAN.md is gitignored), so
        # they watch the plan artifacts instead. A pass that changes nothing has
        # converged, and there is no second-chance iteration to wait for: -n caps
        # such a run but never disables the check.
        if ! $dry_run; then
            if mode_converges_on_plan "$mode"; then
                if [[ "$plan_state_before" == "$plan_state_after" ]]; then
                    echo -e "\n$(convergence_message "$mode" "$iteration")"
                    break
                fi
            elif ! $hard_override; then
                if [[ "$state_before" == "$state_after" ]]; then
                    consecutive_noops=$((consecutive_noops + 1))
                    if [[ $consecutive_noops -ge 2 ]]; then
                        echo -e "\nNo changes detected for 2 consecutive iterations — exiting early."
                        break
                    fi
                else
                    consecutive_noops=0
                fi
            fi
        fi
    done

    echo -e "\nCompleted $iteration iterations."
    if $metrics_enabled && [[ -s "$metrics_file" ]]; then
        echo "Metrics recorded: $metrics_file (summarise with 'ralph metrics')"
    fi
}

cmd_auto() {
    # '-n' is rejected because each phase resolves its own iteration count
    # (see specs/auto-lifecycle.md §8).
    local goal=""
    local model=""
    local backend=""
    local skip_push=false
    local dry_run=false
    local no_metrics=false
    local verbose=false
    local resume=false
    local force=false

    local args
    args=$(getopt -o n:g:m:b:vyh --long iterations:,goal:,model:,backend:,skip-push,dry-run,no-metrics,verbose,yes,help,resume,force -n 'ralph auto' -- "$@")
    eval set -- "$args"

    while true; do
        case "$1" in
            -n|--iterations)
                echo "Error: 'auto' does not accept -n/--iterations; each phase resolves its own iteration count." >&2
                exit 1 ;;
            -g|--goal)     goal="$2";       shift 2 ;;
            -m|--model)    model="$2";      shift 2 ;;
            -b|--backend)  backend="$2";    shift 2 ;;
            --skip-push)   skip_push=true;  shift ;;
            --dry-run)     dry_run=true;    shift ;;
            --no-metrics)  no_metrics=true; shift ;;
            -v|--verbose)  verbose=true;    shift ;;
            -y|--yes)      shift ;;
            --resume)      resume=true;     shift ;;
            --force)       force=true;      shift ;;
            -h|--help)     usage ;;
            --)            shift; break ;;
        esac
    done

    # Container guard (§7). auto runs an unsupervised loop with the backend's
    # permission flag on; outside a container the whole tree and $HOME are
    # reachable. Refuse unless --force, which is the isolated-runner escape
    # hatch. auto prints its own one-line notice, not cmd_loop's backend banner.
    if [[ "${DEVCONTAINER:-false}" != "true" ]]; then
        if ! $force; then
            echo "Error: 'auto' refuses to run outside a container; use --force if this runner is already isolated." >&2
            exit 1
        fi
        echo "auto: running outside a container with --force." >&2
    fi

    # Goal precondition (specs/meta-repo-hardening.md §12). auto's first loop
    # phase is plan, which derives its work from the goal; with none, plan
    # plans against whatever specs/ it happens to resolve. The check sits below
    # the container guard and above every state-changing step, so --dry-run and
    # --resume are refused too — a goal is the one input auto cannot supply.
    if [[ -z $goal ]]; then
        echo "Error: 'auto' requires a goal. Pass -g <specification or directory>." >&2
        exit 1
    fi

    # Report state (§6). One row state per phase, indexed 1-6. The report is the
    # product of the command, so auto_report prints it on every exit path:
    # success, abort, rejected precondition, and interrupt. States seed to
    # 'not reached' so an abort leaves every later phase honestly unreached.
    local -a phase_state=('' 'not reached' 'not reached' 'not reached' 'not reached' 'not reached' 'not reached')
    local auto_resume_notice=""
    auto_report() {
        local i
        echo "" >&2
        echo "Lifecycle summary" >&2
        for i in 1 2 3 4 5 6; do
            printf '  %d %-9s %s\n' "$i" "${RALPH_PHASES[$((i - 1))]}" "${phase_state[$i]}" >&2
        done
        echo "" >&2
        echo "Artifacts: IMPLEMENTATION_PLAN.md and PROGRESS.md in the tree; previous cycle under $ARCHIVE_DIR/<timestamp>/." >&2
        [[ -n $auto_resume_notice ]] && echo "$auto_resume_notice" >&2
        return 0
    }
    # Interrupt (§5). Ctrl-C reaches the whole process group, so the child exits
    # 130 under its own trap and auto records the phase in flight, prints the
    # report and exits 130. A signal to auto alone defers until the child
    # returns (§5 known hazard, §13 fix).
    trap 'phase_state[phase_num]="interrupted"; mkdir -p "$ARCHIVE_DIR"; { echo "phase=$phase_num"; echo "phase_name=$phase"; echo "child_exit=130"; echo "failed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"; } > "$AUTO_STATE_FILE"; auto_report; exit 130' SIGINT SIGTERM

    # Resume entry (§5). A plain run starts at phase 1 and clears any stale
    # state file. --resume re-enters at the recorded phase, floored at
    # RESUME_FLOOR (3) so it never re-runs archive/init over the very artifacts
    # it exists to preserve. It reads 'phase' by field, never sourcing the
    # file, and refuses when the file, the field, or an artifact is missing.
    local start_phase=1
    if $resume; then
        if [[ ! -f $AUTO_STATE_FILE ]]; then
            echo "Error: no interrupted lifecycle to resume (no $AUTO_STATE_FILE)." >&2
            auto_report
            exit 1
        fi
        local recorded_phase
        recorded_phase=$(sed -n 's/^phase=//p' "$AUTO_STATE_FILE" | head -n1)
        if [[ ! $recorded_phase =~ ^[1-6]$ ]]; then
            echo "Error: '$AUTO_STATE_FILE' has no valid 'phase' (1-6) to resume." >&2
            auto_report
            exit 1
        fi
        local f
        for f in IMPLEMENTATION_PLAN.md PROGRESS.md; do
            if [[ ! -f $f ]]; then
                echo "Error: cannot resume; '$f' is absent." >&2
                auto_report
                exit 1
            fi
        done
        local recorded_exit
        recorded_exit=$(sed -n 's/^child_exit=//p' "$AUTO_STATE_FILE" | head -n1)
        start_phase=$recorded_phase
        [[ $start_phase -lt $RESUME_FLOOR ]] && start_phase=$RESUME_FLOOR
        # Manual-repair notice (§5 known hazard). Resume is unconditional; it
        # cannot tell that the recorded failure asked for a hand repair, so it
        # names the phase and child exit and warns the operator to repair first.
        auto_resume_notice="Resumed from phase $recorded_phase (child exit ${recorded_exit:-unknown}). A failure that asked for a manual repair must be repaired before resuming."
        echo "$auto_resume_notice" >&2
        # Phases below the entry point were passed over by --resume, not skipped
        # for a plan reason; mark them distinctly so the report is unambiguous.
        local _p
        for _p in 1 2 3 4 5 6; do
            [[ $_p -lt $start_phase ]] && phase_state[_p]="skipped — resumed at phase $start_phase"
        done
    else
        rm -f "$AUTO_STATE_FILE"
    fi

    # Flags forwarded to the plan/build/review children. archive and init take
    # no such flags, so they are invoked bare. Every child gets -y: auto is the
    # unattended runner and answers its own prompts (§7). -g is not among them:
    # build and review refuse it, so it joins the plan phase's own command line
    # (specs/meta-repo-hardening.md §12).
    local child_flags=()
    [[ -n $model ]]   && child_flags+=(-m "$model")
    [[ -n $backend ]] && child_flags+=(-b "$backend")
    $skip_push        && child_flags+=(--skip-push)
    $no_metrics       && child_flags+=(--no-metrics)
    $verbose          && child_flags+=(-v)

    # Dry run (§8). Print the six phases and, for each loop phase, the exact
    # child command line auto would invoke with the resolved goal/model/backend.
    # Evaluate no guard and invoke no phase: a dry run that moved the plan is the
    # one destructive thing about it, so it must not run archive/init.
    if $dry_run; then
        echo "auto: dry run — the six phases in order (guards are evaluated at run time):" >&2
        local dn=0 dphase
        for dphase in "${RALPH_PHASES[@]}"; do
            dn=$((dn + 1))
            case $dphase in
                archive|init) printf '  %d %-9s %s\n' "$dn" "$dphase" "$RALPH_SELF $dphase" >&2 ;;
                plan)         printf '  %d %-9s %s\n' "$dn" "$dphase" "$RALPH_SELF $dphase -g $goal ${child_flags[*]} -y" >&2 ;;
                *)            printf '  %d %-9s %s\n' "$dn" "$dphase" "$RALPH_SELF $dphase ${child_flags[*]} -y" >&2 ;;
            esac
        done
        return 0
    fi

    # Phase loop (§3, §4). Each phase is a child of RALPH_SELF so a cmd_loop
    # failure path (a non-zero backend, a jq failure, a rejected push) becomes
    # an exit status auto decides on, instead of taking the lifecycle down, and
    # so each phase's traps and globals stay its own. On a child failure auto
    # records the state file and exits 1.
    local phase_num=0 phase child_exit
    for phase in "${RALPH_PHASES[@]}"; do
        phase_num=$((phase_num + 1))

        [[ $phase_num -lt $start_phase ]] && continue

        # Guards read the plan as it stands on disk right now, never a decision
        # made earlier in the run. build (4, 6) needs both artifacts and an
        # open item; review (5) needs both artifacts, a shipped item, no open
        # item, and one cited spec. The guards mirror the hard stops in
        # require_open_items and require_review_preconditions, so auto never
        # starts a child that exits 1 on a gate. A guarded-out phase is
        # skipped, not an abort.
        case $phase_num in
            4|6)
                if [[ ! -f IMPLEMENTATION_PLAN.md || ! -f PROGRESS.md ]]; then
                    phase_state[phase_num]="skipped — no plan artifacts"; continue
                elif ! have_open_items; then
                    phase_state[phase_num]="skipped — no open items"; continue
                fi ;;
            5)
                if [[ ! -f IMPLEMENTATION_PLAN.md || ! -f PROGRESS.md ]]; then
                    phase_state[phase_num]="skipped — no plan artifacts"; continue
                elif ! have_shipped_items; then
                    phase_state[phase_num]="skipped — no shipped items"; continue
                elif have_open_items; then
                    phase_state[phase_num]="skipped — $(count_plan_items '^- \[ \]') open items remain"; continue
                elif ! have_cited_specs; then
                    phase_state[phase_num]="skipped — no cited specs"; continue
                fi ;;
        esac

        child_exit=0
        case $phase in
            archive|init) "$RALPH_SELF" "$phase" ;;
            plan)         "$RALPH_SELF" "$phase" -g "$goal" "${child_flags[@]}" -y ;;
            *)            "$RALPH_SELF" "$phase" "${child_flags[@]}" -y ;;
        esac || child_exit=$?
        if [[ $child_exit -ne 0 ]]; then
            phase_state[phase_num]="failed — exit $child_exit"
            mkdir -p "$ARCHIVE_DIR"
            {
                echo "phase=$phase_num"
                echo "phase_name=$phase"
                echo "child_exit=$child_exit"
                echo "failed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            } > "$AUTO_STATE_FILE"
            echo "Re-run: $RALPH_SELF auto --resume" >&2
            auto_report
            exit 1
        fi
        phase_state[phase_num]="ran"

        # Phase 2 asserts what init was supposed to scaffold. cmd_init exits 0
        # even when a template is missing, leaving the artifact absent, so plan
        # (phase 3) would hard-stop and abort. Fail the lifecycle here instead.
        if [[ $phase_num -eq 2 ]]; then
            local f
            for f in IMPLEMENTATION_PLAN.md PROGRESS.md; do
                if [[ ! -f $f ]]; then
                    echo "Error: '$f' is missing after init; check the template in $CONFIG_DIR/templates." >&2
                    auto_report
                    exit 1
                fi
            done
        fi
    done

    # Reaching phase 6 is a completed lifecycle, including one that skipped
    # phases; remove the state file so a later --resume finds nothing.
    rm -f "$AUTO_STATE_FILE"
    auto_report
}

# Main dispatch — test/resolve_prompt.bats sources everything above this line
case "${1:-}" in
    sandbox)    shift; cmd_sandbox "$@" ;;
    plan|build|review) cmd_loop "$@" ;;
    auto)       shift; cmd_auto "$@" ;;
    metrics)    shift; cmd_metrics "$@" ;;
    init)       shift; cmd_init "$@" ;;
    clean)      cmd_clean ;;
    archive)    cmd_archive ;;
    version)    cmd_version ;;
    -h|--help)  usage ;;
    "")         usage ;;
    *)          echo "Error: unknown command '$1'"; exit 1 ;;
esac
